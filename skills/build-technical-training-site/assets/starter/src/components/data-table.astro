---
interface Props { caption: string; headers: string[]; rows: Array<Array<string>> }
const { caption, headers, rows } = Astro.props;
const colCount = headers.length;
---
<figure class="data-table not-content" style={`--data-cols: ${colCount}`} aria-label={caption}>
  <figcaption class="data-table-caption">{caption}</figcaption>
  <div class="data-table-grid" role="table">
    <div class="data-table-row data-table-head" role="row">
      {headers.map((header) => (
        <div class="data-table-cell" role="columnheader">{header}</div>
      ))}
    </div>
    {rows.map((row) => (
      <div class="data-table-row" role="row">
        {row.map((cell) => (
          <div class="data-table-cell" role="cell">{cell}</div>
        ))}
      </div>
    ))}
  </div>
</figure>
