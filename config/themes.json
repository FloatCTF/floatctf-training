        "infoBackground": "#F1F5FA",
        "infoText": "#17375E",
        "warningBackground": "#FFF6D8",
        "warningText": "#513600",
        "dangerBackground": "#FBECEC",
        "dangerText": "#6F1D23",
        "successBackground": "#EAF5ED",
        "successText": "#174A29",
        "codeBackground": "#F2F2F2",
