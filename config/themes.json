        "classOne": "#FFB86B",
        "link": "#E4896D",
        "danger": "#E0705A",
        "safe": "#8CC79C",
        "infoBackground": "#2A251D",
        "infoText": "#E5C98B",
        "warningBackground": "#342817",
        "warningText": "#F0D28F",
        "dangerBackground": "#321A18",
        "dangerText": "#F2A79A",
        "successBackground": "#18281D",
        "successText": "#A9D3B2",
        "codeBackground": "#090907",
        "codeText": "#F3ECDD",
        "focusRing": "#E4896D",
        "tableHeader": "#29261F",
        "tableHeaderText": "#FFF8E9",
        "tableZebra": "#22201B"
