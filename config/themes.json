{
  "themes": [
    {
      "id": "light-editor",
      "label": "浅色编辑风",
      "mode": "light",
      "selector": ":root, :root[data-theme='light']",
      "colors": {
        "pageBackground": "#F4F0E5",
        "surfaceBackground": "#FBF7EC",
        "text": "#28251E",
        "mutedText": "#6B6559",
        "heading": "#17150F",
        "border": "#817867",
        "accent": "#A63D2C",
        "classZero": "#21618C",
        "classOne": "#A64B00",
        "link": "#8B2E23",
        "danger": "#B3261E",
        "safe": "#1B7F3B",
        "infoBackground": "#F2E8C9",
        "infoText": "#694D16",
        "warningBackground": "#F5E2B8",
        "warningText": "#67400A",
        "dangerBackground": "#F4D8D1",
        "dangerText": "#7F261D",
        "successBackground": "#DDE9DA",
        "successText": "#285D37",
        "codeBackground": "#171714",
        "codeText": "#F2ECD9",
        "focusRing": "#A63D2C",
        "tableHeader": "#17150F",
        "tableHeaderText": "#F8F2E4",
        "tableZebra": "#EAE3D3"
      }
    },
    {
      "id": "dark-presentation",
