---
// 卷积 = 同一张 3×3 小模板扫过所有位置。窗口位置、3×3 像素值和响应全部由真实位图现场计算。
import { DIGIT_BITMAPS } from '../data/handwritten-digits';

const digit = DIGIT_BITMAPS.find((d) => d.key === 'round3')!;
const N = digit.rows.length;
const px: number[][] = digit.rows.map((row) =>
  row.split('').map((ch) => Number.parseInt(ch, 16) / 15),
);

// 竖笔画模板：只有中列为 +1，左右两列为 0
const response = (r: number, c: number) =>
  px[r][c + 1] + px[r + 1][c + 1] + px[r + 2][c + 1];

const emptyWin = { r: 2, c: 2, n: '1', name: '空白角落', lx: 2, ly: 2 };
const arcWin = { r: 3, c: 13, n: '2', name: '上弧横线', lx: 13, ly: 3 };
let strokeWin = { r: 12, c: 22, n: '3', name: '右竖笔画', lx: 22, ly: 12 };
let best = -1;
for (let r = 8; r <= 17; r += 1) {
  for (let c = 20; c <= 24; c += 1) {
    const score = response(r, c);
    if (score > best) {
      best = score;
      strokeWin = { ...strokeWin, r, c, lx: c, ly: r };
    }
  }
}

const windows = [emptyWin, arcWin, strokeWin].map((w) => {
  const patch = [0, 1, 2].map((dr) => [0, 1, 2].map((dc) => px[w.r + dr][w.c + dc]));
  const midVals = [patch[0][1], patch[1][1], patch[2][1]];
  return {
    ...w,
    patch,
    sumExpr: `${midVals.map((v) => v.toFixed(2)).join(' + ')} = ${response(w.r, w.c).toFixed(2)}`,
    value: response(w.r, w.c),
  };
});

const CELL = 8.8;
const GRID_X = 20;
const GRID_Y = 36;
const KERNEL_X = 304;
const KERNEL_Y = 56;
const KERNEL_CELL = 30;
---

<section class="conv-window lesson-diagram not-content" aria-label="卷积核在手写数字上滑动的示意">
  <header>
    <p class="lesson-diagram__eyebrow">权重共享 / 同一张 3×3 模板扫全图</p>
    <h3 class="lesson-diagram__title">放大看卷积：3×3 小模板怎么给每个位置打分</h3>
    <p class="conv-window__intro">
      左边还是那张 28×28 的手写「3」。我们拿一张 3×3 竖笔画模板（中列权重 +1，两侧 0）滑过全图。
      右侧把三个框里的 9 个像素放大摊开：把中列三格的墨量相加，就是这一格的卷积输出。
    </p>
  </header>
  <div class="conv-window__body">
    <svg viewBox="0 0 740 318" role="img" aria-label="左侧手写 3 位图上标出三个 3×3 观察框，中间是 3×3 竖笔画模板，右侧是三个位置的放大格与得分条">
      <title>卷积滑动窗口与逐格打分</title>
      <text class="diagram-label" x={GRID_X} y="24">输入：28×28 手写「3」</text>
      <rect class="cw-paper" x={GRID_X} y={GRID_Y} width={N * CELL} height={N * CELL} />
      {px.map((row, r) =>
        row.map((v, c) =>
          v > 0 ? (
            <rect
              class="cw-ink"
              x={GRID_X + c * CELL + 0.4}
              y={GRID_Y + r * CELL + 0.4}
              width={CELL - 0.8}
              height={CELL - 0.8}
              style={`--ink: ${v.toFixed(3)}`}
            />
          ) : null,
        ),
      )}
      {windows.map((w) => {
        const fx = GRID_X + w.c * CELL;
        const fy = GRID_Y + w.r * CELL;
        // 徽章放在框外侧（位置 3 贴右边，放框左侧以免压黑笔画）
        const bx = w.n === '3' ? fx - 13 : fx - 10;
        const by = w.n === '3' ? fy + 14 : fy - 8;
        return (
          <g>
            <rect
              class:list={['cw-frame', w.value > 1.2 && 'cw-frame--hit']}
              x={fx}
              y={fy}
              width={CELL * 3}
              height={CELL * 3}
            />
            <circle class="cw-badge" cx={bx} cy={by} r="10" />
            <text class="cw-badge-text" x={bx} y={by + 4} text-anchor="middle">{w.n}</text>
          </g>
        );
      })}

      <text class="diagram-label" x={KERNEL_X + KERNEL_CELL * 1.5} y="36" text-anchor="middle">3×3 模板（9 个权重）</text>
      {[0, 1, 2].map((r) =>
        [0, 1, 2].map((c) => (
          <g>
            <rect
              class:list={['cw-kernel', c === 1 && 'cw-kernel--on']}
              x={KERNEL_X + c * KERNEL_CELL}
              y={KERNEL_Y + r * KERNEL_CELL}
              width={KERNEL_CELL}
              height={KERNEL_CELL}
            />
            <text
              class:list={[c === 1 ? 'cw-kernel-value' : 'cw-kernel-zero']}
              x={KERNEL_X + c * KERNEL_CELL + KERNEL_CELL / 2}
              y={KERNEL_Y + r * KERNEL_CELL + 20}
              text-anchor="middle"
            >
              {c === 1 ? '+1' : '0'}
            </text>
          </g>
        )),
      )}
      <text class="cw-kernel-note" x={KERNEL_X + KERNEL_CELL * 1.5} y={KERNEL_Y + KERNEL_CELL * 3 + 22} text-anchor="middle">中列 +1，两侧 0</text>
      <text class="cw-kernel-note" x={KERNEL_X + KERNEL_CELL * 1.5} y={KERNEL_Y + KERNEL_CELL * 3 + 40} text-anchor="middle">（专找竖笔画）</text>

      {windows.map((w, i) => {
        const rowY = 48 + i * 86;
        const patchX = 430;
        const pCell = 15;
        return (
          <g>
            <rect class="cw-patch-bg" x={patchX} y={rowY} width={pCell * 3} height={pCell * 3} />
            {w.patch.map((pRow, pr) =>
              pRow.map((val, pc) => (
                <rect
                  class:list={['cw-patch-cell', pc === 1 && 'cw-patch-cell--mid']}
                  x={patchX + pc * pCell}
                  y={rowY + pr * pCell}
                  width={pCell}
                  height={pCell}
                  style={`--ink: ${val.toFixed(3)}`}
                />
              )),
            )}
            <text class="cw-res-label" x={patchX + 58} y={rowY + 14}>{`位置 ${w.n} · ${w.name}`}</text>
            <rect class="cw-res-track" x={patchX + 58} y={rowY + 23} width={128} height={12} rx="3" />
            <rect
              class:list={['cw-res-fill', w.value > 1.2 && 'cw-res-fill--hit']}
              x={patchX + 58}
              y={rowY + 23}
              width={Math.max(3, Math.min(1, w.value / 3) * 128)}
              height={12}
              rx="3"
            />
            <text class="cw-res-value" x={patchX + 194} y={rowY + 34}>{w.value.toFixed(2)}</text>
            <text class="cw-res-note" x={patchX + 58} y={rowY + 52}>中列求和：{w.sumExpr}</text>
          </g>
        );
      })}
    </svg>
  </div>
  <p class="lesson-diagram__note conv-window__note">
    全连接要给 784 个像素各自配权重；卷积不管「3」写在左上角还是右下角，都只复用这 9 个数扫全图——这就是为什么 CNN 参数极省，还不怕图像平移。
  </p>
</section>
