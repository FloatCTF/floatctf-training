---
const LARGE_CELLS = Array.from({ length: 64 });
const B_CELLS = Array.from({ length: 16 });
const A_CELLS = Array.from({ length: 16 });
import LessonDiagram from './lesson-diagram.astro';
---
<LessonDiagram
  eyebrow="LORA / 只训两条窄矩阵"
  title="冻住大矩阵 W，只训练旁边两条窄矩阵 B × A"
  ariaLabel="LoRA 低秩分解示意"
  class="lora-decomposition"
  note="原始权重 W 动辄几亿参数，全量重训显存吃不消。LoRA 冻住 W，只训极窄的 B 和 A（秩 r 远小于维度 d）；上线前把 B×A 算出来加回 W，推理速度完全不变。"
>
  <div class="lora-decomposition__body" role="img" aria-label="左侧是冻结的八乘八权重矩阵 W；中间只训练八乘二矩阵 B 和二乘八矩阵 A，相乘得到同形状的更新量，最后与 W 合并">
    <div class="lora-matrix-group">
      <span class="lora-badge">冻结不动</span>
      <strong>W</strong>
      <div class="lora-matrix lora-matrix--large">{LARGE_CELLS.map(() => <i></i>)}</div>
      <small>d × d（原模型）</small>
    </div>
    <span class="lora-operator">+</span>
    <div class="lora-adapter">
      <span class="lora-badge lora-badge--train">只训练这里</span>
      <div class="lora-adapter__pair">
        <div class="lora-matrix-group">
          <strong>B</strong>
          <div class="lora-matrix lora-matrix--tall">{B_CELLS.map(() => <i></i>)}</div>
          <small>d × r</small>
        </div>
        <span class="lora-operator">×</span>
        <div class="lora-matrix-group">
          <strong>A</strong>
          <div class="lora-matrix lora-matrix--wide">{A_CELLS.map(() => <i></i>)}</div>
          <small>r × d</small>
        </div>
      </div>
    </div>
    <span class="lora-operator">=</span>
    <div class="lora-matrix-group">
      <span class="lora-badge lora-badge--merge">部署时合并</span>
      <strong>W + B×A</strong>
      <div class="lora-matrix lora-matrix--large lora-matrix--merged">{LARGE_CELLS.map(() => <i></i>)}</div>
      <small>d × d（零额外延迟）</small>
    </div>
  </div>
</LessonDiagram>
