---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';

interface RouteData {
  hasSidebar: boolean;
  entry: { data: { pageType?: string } };
}

const route = (Astro.locals as unknown as { starlightRoute: RouteData }).starlightRoute;
const pageType = route.entry.data.pageType || 'default';
const showSidebar = route.hasSidebar && !['home', 'category', 'lesson', 'path'].includes(pageType);
---

<div class:list={['page', 'sl-flex', `page-${pageType}`]} data-page-type={pageType}>
  <header class="header"><slot name="header" /></header>
  {showSidebar && (
    <nav class="sidebar print:hidden" aria-label="全站课程导航">
      <MobileMenuToggle />
      <div id="starlight__sidebar" class="sidebar-pane">
        <div class="sidebar-content sl-flex"><slot name="sidebar" /></div>
      </div>
    </nav>
  )}
  <div class="main-frame"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .page { flex-direction: column; min-height: 100vh; }
    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }
    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }
    :global([aria-expanded='true']) ~ .sidebar-pane { --sl-sidebar-visibility: visible; }
    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }
    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }
    .page-home .main-frame,
    .page-category .main-frame,
    .page-lesson .main-frame,
    .page-path .main-frame { padding-inline-start: 0; }
    @media (min-width: 50rem) {
      .sidebar-content::after { content: ''; padding-bottom: 1px; }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }
</style>
