---
const route = (Astro.locals as unknown as {
  starlightRoute: { toc?: unknown; entry: { data: { pageType?: string } } };
}).starlightRoute;
const pageType = route.entry.data.pageType || 'default';
const showTableOfContents = Boolean(route.toc) && !['home', 'category', 'lesson'].includes(pageType);
---

<div class="lg:sl-flex">
  {showTableOfContents && (
    <aside class="right-sidebar-container print:hidden">
      <div class="right-sidebar"><slot name="right-sidebar" /></div>
    </aside>
  )}
  <div class="main-pane"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .main-pane { isolation: isolate; width: 100%; }
    @media (min-width: 72rem) {
      .right-sidebar-container {
        order: 2;
        position: relative;
        width: max(var(--sl-sidebar-width), calc(var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2));
      }
      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding-top: var(--sl-nav-height);
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }
      :global([data-has-sidebar][data-has-toc]) .main-pane {
        --sl-content-margin-inline: auto 0;
        order: 1;
        width: min(calc(100% - var(--sl-sidebar-width)), calc(var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2));
      }
      :global(.page-home, .page-category, .page-lesson) .main-pane {
        --sl-content-margin-inline: auto;
        order: initial;
        width: 100%;
      }
    }
  }
</style>
