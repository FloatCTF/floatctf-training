---
// 自回归生成循环：对称居中的四步顺时针闭环 + 具体句子示例
const W = 186;
const H = 62;
const steps = [
  { x: 155, y: 84, label: '1. 当前上下文', sub: '「漏洞修复后应运行」' },
  { x: 465, y: 84, label: '2. 模型前向算分', sub: 'Transformer 算一遍' },
  { x: 465, y: 214, label: '3. 给出概率分布', sub: '测试 58% · 构建 21%…' },
  { x: 155, y: 214, label: '4. 选出 1 个 token', sub: '抽中「测试」' },
];
import LessonDiagram from './lesson-diagram.astro';
---
<LessonDiagram
  eyebrow="AUTOREGRESSIVE LOOP / 一次吐一个"
  title="为什么大模型的回答是一个字一个字蹦出来的？"
  ariaLabel="自回归生成循环"
  note="生成 100 个 token 就要把这四步转上 100 圈。这就是回答越长等得越久、API 也按 token 计费的根本原因（实际工程会用 KV cache 缓存前面算过的部分来提速）。"
>
  <svg viewBox="0 0 620 296" role="img" aria-label="自回归四步闭环：当前上下文送入模型前向算分，得到下一 token 概率分布，采样选出「测试」，再拼回上下文进入下一轮">
    <title>自回归生成循环</title>
    <defs>
      <marker id="loop-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 1 L 9 5 L 0 9 z" class="diagram-arrow-head" />
      </marker>
      <marker id="loop-return-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 1 L 9 5 L 0 9 z" style="fill: var(--training-accent)" />
      </marker>
    </defs>

    {/* 1 → 2 */}
    <line x1={155 + W / 2 + 4} y1={84} x2={465 - W / 2 - 4} y2={84} class="diagram-arrow" marker-end="url(#loop-arrow)" />
    {/* 2 → 3 */}
    <line x1={465} y1={84 + H / 2 + 4} x2={465} y2={214 - H / 2 - 4} class="diagram-arrow" marker-end="url(#loop-arrow)" />
    {/* 3 → 4 */}
    <line x1={465 - W / 2 - 4} y1={214} x2={155 + W / 2 + 4} y2={214} class="diagram-arrow" marker-end="url(#loop-arrow)" />
    {/* 4 → 1（拼回上下文，闭环） */}
    <line x1={155} y1={214 - H / 2 - 4} x2={155} y2={84 + H / 2 + 4} class="diagram-arrow diagram-arrow--loop" marker-end="url(#loop-return-arrow)" />

    <text x="168" y="154" class="diagram-lane-label" style="fill: var(--training-accent); font-weight: 700;">拼回末尾，开始下一轮</text>
    <text x="310" y="278" text-anchor="middle" class="diagram-lane-label">每多吐 1 个 token，整圈流程就再转一遍，直到生成结束符</text>

    {steps.map((s) => (
      <g>
        <rect x={s.x - W / 2} y={s.y - H / 2} width={W} height={H} rx="10" class="diagram-box diagram-box--proc" />
        <text x={s.x} y={s.y - 5} text-anchor="middle" class="diagram-box-label">{s.label}</text>
        <text x={s.x} y={s.y + 17} text-anchor="middle" class="diagram-box-sub">{s.sub}</text>
      </g>
    ))}
  </svg>
</LessonDiagram>
