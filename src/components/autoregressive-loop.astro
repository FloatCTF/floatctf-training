---
// 自回归生成循环：为什么模型的回答一个 token 一个 token 往外蹦
const steps = [
  { x: 110, y: 60, label: '当前上下文', sub: '已生成的全部 token' },
  { x: 110, y: 210, label: '模型前向计算', sub: '一次 Transformer 前向' },
  { x: 340, y: 210, label: '下一 token 分布', sub: 'softmax 概率' },
  { x: 340, y: 60, label: '选出 1 个 token', sub: '按分布采样' },
];
const W = 168;
const H = 54;
const arrows: [number, number, number, number][] = [
  [110, 60 + H / 2 + 4, 110, 210 - H / 2 - 4],
  [110 + W / 2 + 4, 210, 340 - W / 2 - 4, 210],
  [340, 210 - H / 2 - 4, 340, 60 + H / 2 + 4],
];
---
<section class="lesson-diagram not-content" aria-label="自回归生成循环">
  <p class="lesson-diagram__eyebrow">AUTOREGRESSIVE LOOP / 一次一个</p>
  <h3 class="lesson-diagram__title">为什么回答是一个字一个字蹦出来的</h3>
  <svg viewBox="0 0 560 290" role="img" aria-label="自回归循环：当前上下文送入模型，得到下一 token 的概率分布，采样选出一个 token，拼回上下文再进入下一轮，循环直到结束。">
    <title>自回归生成循环</title>
    <defs>
      <marker id="loop-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="diagram-arrow-head" />
      </marker>
    </defs>
    {steps.map((s) => (
      <g>
        <rect x={s.x - W / 2} y={s.y - H / 2} width={W} height={H} rx="10" class="diagram-box diagram-box--proc" />
        <text x={s.x} y={s.y - 4} text-anchor="middle" class="diagram-box-label">{s.label}</text>
        <text x={s.x} y={s.y + 16} text-anchor="middle" class="diagram-box-sub">{s.sub}</text>
      </g>
    ))}
    {arrows.map(([x1, y1, x2, y2]) => (
      <line x1={x1} y1={y1} x2={x2} y2={y2} class="diagram-arrow" marker-end="url(#loop-arrow)" />
    ))}
    <path d="M 424, 60 C 510 18, 88 18, 194 60" class="diagram-arrow diagram-arrow--loop" marker-end="url(#loop-arrow)" fill="none" />
    <text x="309" y="22" text-anchor="middle" class="diagram-lane-label">选出的 token 拼回上下文</text>
    <text x="196" y="248" class="diagram-lane-label">每个新 token 都要完整走一圈前向计算</text>
  </svg>
  <p class="lesson-diagram__note">生成 100 个 token 就是 100 圈循环，这是长回答更慢、推理成本按 token 计费的原因。</p>
</section>
