---
// 覆盖 Starlight 默认 Head：先输出框架生成的全部 head 标签，再以非阻塞方式加载 @fontsource 字体。
// 字体样式表在 media="print" 与 onload 切换下不阻塞首屏渲染；无 JavaScript 时退回普通样式表。
interface HeadEntry {
  tag: string;
  attrs?: Record<string, string | number | boolean | undefined>;
  content?: string;
}

const { head } = (Astro.locals as unknown as { starlightRoute: { head: HeadEntry[] } }).starlightRoute;
const fontsHref = `${import.meta.env.BASE_URL}fontsource/fonts.css`;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<link rel="preload" as="style" href={fontsHref} />
<link rel="stylesheet" href={fontsHref} media="print" onload={'this.media=\'all\''} />
<noscript><link rel="stylesheet" href={fontsHref} /></noscript>
