---
import TitledBox from './titled-box.astro';

interface Props { variant?: 'info' | 'warning' | 'danger' | 'success'; title: string }
const { variant = 'info', title } = Astro.props;
const roles = { info: 'note', warning: 'note', danger: 'alert', success: 'status' } as const;
const labels = { info: 'INFORMATION', warning: 'WARNING', danger: 'DANGER', success: 'VERIFIED' } as const;
---

<TitledBox
  class={`callout callout-${variant}`}
  kicker={labels[variant]}
  kickerClass="callout-label"
  title={title}
  headingLevel="h3"
  role={roles[variant]}
>
  <slot />
</TitledBox>
