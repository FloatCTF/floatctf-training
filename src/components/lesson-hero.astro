---
const manifests = import.meta.glob('../data/lessons/*.json', { eager: true, import: 'default' }) as Record<string, { lessonPlan: { audience: string; durationMinutes: number } }>;
interface HeroLine {
  text: string;
  accent?: boolean;
  latin?: boolean;
}

interface Props {
  series: string;
  unit: string;
  kicker: string;
  lines: HeroLine[];
  summary: string;
}

const { series, unit, kicker, lines, summary } = Astro.props;
const route = (Astro.locals as unknown as { starlightRoute: { entry: { id: string }; headings: { depth: number; slug: string; text: string }[] } }).starlightRoute;
const id = route.entry.id.replace(/^lessons\//, '');
const plan = manifests[`../data/lessons/${id}.json`]?.lessonPlan;
const firstHeading = route.headings.find((heading) => heading.depth === 2);
const titleLength = lines.reduce((total, line) => total + line.text.replace(/\s+/g, '').length, 0);
const lengthClass = titleLength <= 10 ? 'lesson-title-short' : titleLength <= 16 ? 'lesson-title-medium' : 'lesson-title-long';
---
<section class:list={['lesson-hero', lengthClass]} aria-labelledby="_top">
  <div class="lesson-hero-topline">
    <span class="lesson-series"><span class="lesson-signal" aria-hidden="true"></span>{series}</span>
    <span>{unit}</span>
  </div>
  <div class="lesson-hero-main">
    <p class="lesson-hero-kicker">{kicker}</p>
    <div class="lesson-display-title" aria-hidden="true">
      {lines.map((line) => (
        <span class:list={[{ 'lesson-title-accent': line.accent, 'lesson-title-latin': line.latin, 'lesson-title-code': /^CWE-/.test(line.text) }]}>{line.text}</span>
      ))}
    </div>
    <span class="lesson-accent-rule" aria-hidden="true"></span>
    <p class="lesson-hero-summary">{summary}</p>
    {plan && <p class="lesson-hero-meta">{plan.audience} · 建议 {plan.durationMinutes} 分钟</p>}
    {firstHeading && <a href={`#${firstHeading.slug}`}>开始阅读：{firstHeading.text} →</a>}
  </div>
</section>
