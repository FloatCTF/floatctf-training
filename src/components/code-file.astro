---
// 代码清单：直接读取 public/labs/<课 id>/ 下的文件来展示，页面上的代码与学员下载、重放时运行的是同一份。
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { Code } from '@astrojs/starlight/components';
import { withBase } from '../lib/base-url';

interface Props {
  file: string;
  /** 语法高亮语言；省略时按扩展名推断。 */
  lang?: string;
  /** 需要标亮的行，写法同代码围栏的行标记，例如 "3" 或 "2-4"。 */
  mark?: string;
  /** 代码下方的一句说明。 */
  note?: string;
}

const { file, lang, mark, note } = Astro.props;
if (!/^labs\/[a-z0-9-]+\/[A-Za-z0-9._-]+$/.test(file) || file.includes('..')) throw new Error(`Unknown lesson material: ${file}`);
const source = readFileSync(resolve('public', file), 'utf8').replace(/\n+$/, '');
const name = file.split('/').pop() || file;
const extension = name.includes('.') ? name.split('.').pop() || '' : '';
const languages: Record<string, string> = { py: 'python', sh: 'bash', c: 'c', h: 'c', php: 'php', js: 'js', sql: 'sql', html: 'html', css: 'css', java: 'java', txt: 'text', log: 'text' };
const language = lang ?? languages[extension] ?? 'text';
---
<div class="code-file">
  <Code code={source} lang={language} title={name} mark={mark} />
  <p class="code-file__meta not-content">
    <a href={withBase(`/${file}`)} download={name}>下载 {name}</a>
    {note && <span>{note}</span>}
  </p>
</div>
