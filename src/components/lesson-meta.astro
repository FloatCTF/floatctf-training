---
interface Item {
  label: string;
  value: string;
}
interface Props {
  items: Item[];
  label?: string;
}
const { items, label = '专题信息' } = Astro.props;
---
{items.length > 0 && (
  <dl class="lesson-meta" aria-label={label}>
    {items.map((item) => (
      <div>
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
)}
