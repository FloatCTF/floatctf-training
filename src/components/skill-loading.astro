---
// Skill 渐进式加载：按需逐层展开，卡片宽度示意上下文成本
const LAYERS = [
  {
    name: '名称与描述',
    when: '发现 Skill 时',
    what: '做什么、何时使用',
    cost: '极小',
    size: 'compact',
  },
  {
    name: 'SKILL.md 正文',
    when: 'Skill 被触发时',
    what: '步骤、边界、输入输出、停止条件',
    cost: '中',
    size: 'medium',
  },
  {
    name: 'references / assets / scripts',
    when: '具体步骤需要时',
    what: '细节、模板、确定性处理',
    cost: '大；未读取时不占窗口',
    size: 'full',
  },
];
import LessonDiagram from './lesson-diagram.astro';
---
<LessonDiagram eyebrow="SKILLS / 按需逐层加载" title="Skill 的三层加载：先看名片，再翻正文，最后开资料柜" labelledBy="skill-loading-title" titleId="skill-loading-title" class="skill-loading" headered note="卡片宽度示意上下文成本。名称与描述帮助模型判断是否触发；正文提供执行骨架；大资料只在对应步骤读取。 逐层加载让上下文窗口保留给当前任务真正需要的信息。" noteClass="skill-loading__note">
  <ol class="skill-loading__steps" aria-label="Skill 的三个加载层级">
    {LAYERS.map((layer, i) => (
      <li class="skill-loading__step">
        <article class:list={['sl-layer', `sl-layer--${layer.size}`]}>
          <span class="sl-layer__index" aria-hidden="true">0{i + 1}</span>
          <div class="sl-layer__copy">
            <h4>{layer.name}</h4>
            <dl>
              <div><dt>何时</dt><dd>{layer.when}</dd></div>
              <div><dt>加载</dt><dd>{layer.what}</dd></div>
            </dl>
          </div>
          <p class="sl-layer__cost"><span>上下文成本</span><strong>{layer.cost}</strong></p>
        </article>
        {i < LAYERS.length - 1 && (
          <p class="skill-loading__transition" aria-label="需要时才继续加载下一层">
            <span aria-hidden="true">↓</span> 需要时才往下走
          </p>
        )}
      </li>
    ))}
  </ol>
  
</LessonDiagram>
