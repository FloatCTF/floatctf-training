---
// Token embedding 空间示意：语义相近的 token 聚在一起（压缩到两维的示意图）
interface TokenPoint { x: number; y: number; text: string; dy?: number }

const CLUSTERS: { name: string; cx: number; cy: number; rx: number; ry: number; points: TokenPoint[] }[] = [
  {
    name: '动物类', cx: 162, cy: 118, rx: 86, ry: 58,
    points: [
      { x: 146, y: 94, text: '猫', dy: -11 },
      { x: 194, y: 126, text: '狗', dy: -11 },
      { x: 142, y: 148, text: '鱼', dy: 19 },
      { x: 102, y: 122, text: '鸟', dy: -11 },
    ],
  },
  {
    name: '动作类', cx: 492, cy: 114, rx: 86, ry: 58,
    points: [
      { x: 462, y: 94, text: '跑', dy: -11 },
      { x: 526, y: 102, text: '跳', dy: -11 },
      { x: 514, y: 144, text: '写', dy: 19 },
      { x: 454, y: 140, text: '吃', dy: 19 },
    ],
  },
  {
    name: '数字类', cx: 326, cy: 234, rx: 104, ry: 38,
    points: [
      { x: 256, y: 238, text: '一', dy: -11 },
      { x: 304, y: 228, text: '二', dy: -11 },
      { x: 350, y: 248, text: '100', dy: -11 },
      { x: 400, y: 230, text: '3.14', dy: -11 },
    ],
  },
];
---

<section class="embedding-space not-content" aria-label="token 向量空间示意图">
  <figure class="embedding-space__figure">
    <svg viewBox="0 0 640 344" role="img" aria-label="二维示意坐标里有动物、动作、数字三个簇；绿线连着猫和狗表示距离近，虚线连着猫和跑表示距离远">
      <title>Embedding 向量空间示意</title>
      <line class="es-axis" x1="48" y1="312" x2="612" y2="312" />
      <line class="es-axis" x1="48" y1="312" x2="48" y2="28" />
      <text class="es-axis-label" x="610" y="336" text-anchor="end">维度 1（示意）→</text>
      <text class="es-axis-label" x="58" y="24">↑ 维度 2（示意）</text>

      {CLUSTERS.map((c) => (
        <ellipse class="es-hull" cx={c.cx} cy={c.cy} rx={c.rx} ry={c.ry} />
      ))}
      {CLUSTERS.map((c) => (
        <text class="es-hull-label" x={c.cx} y={c.cy + c.ry + 20} text-anchor="middle">{c.name}</text>
      ))}

      {/* 连线精确连接「猫(146,94)—狗(194,126)」和「猫(146,94)—跑(462,94)」 */}
      <line class="es-link es-link--near" x1="152" y1="98" x2="188" y2="122" />
      <text class="es-link-label es-link-label--near" x="150" y="48" text-anchor="middle">猫和狗：距离近</text>
      <line class="es-link es-link--far" x1="154" y1="94" x2="454" y2="94" />
      <text class="es-link-label es-link-label--far" x="316" y="84" text-anchor="middle">猫和跑：距离远</text>

      {CLUSTERS.map((c) => c.points.map((p) => (
        <g>
          <circle class="es-point" cx={p.x} cy={p.y} r="5.5" />
          <text class="es-point-label" x={p.x} y={p.y + (p.dy ?? -11)} text-anchor="middle">{p.text}</text>
        </g>
      )))}
    </svg>
    <figcaption>真实词向量通常有几千维，画不出来，这里压成二维帮助建立直觉：用法相近的词，坐标靠得近。</figcaption>
  </figure>
  <p class="lesson-diagram__note embedding-space__note">
    刚初始化时，每个词的向量全是乱填的随机数；训练过程中，经常出现在相似语境里的词（比如「猫」和「狗」）会被一步步拉到相邻的位置。
  </p>
</section>
