---
// RNN 展开图：左「卷起来」的循环单元，右沿时间展开的四个时间步，左右独立分区零重叠
const STEPS = [
  { t: 1, x: '这', y: 'h₁' },
  { t: 2, x: '只', y: 'h₂' },
  { t: 3, x: '猫', y: 'h₃' },
  { t: 4, x: '跑', y: 'h₄' },
];
const CELL_W = 86;
const CELL_H = 54;
const STEP_GAP = 118;
const START_X = 248;
const CELL_Y = 124;
import LessonDiagram from './lesson-diagram.astro';
---
<LessonDiagram
  eyebrow="顺序结构 / 展开才见深度"
  title="RNN：同一套权重，按时间一步步展开"
  ariaLabel="循环神经网络展开与沿时间反向传播的示意"
  class="rnn-unfold"
  headered
  note="写公式时看着只有一个循环盒子，真正处理 100 个词的句子时，它等价于 100 层串联网络。误差从句尾倒流回句首每退一步都要乘一次权重，连乘变小就会「忘掉开头说过什么」。"
  noteClass="rnn-unfold__note"
>
  <div class="rnn-unfold__body">
    <svg viewBox="0 0 760 310" role="img" aria-label="左侧是带自循环箭头的单个 RNN 单元，中间是展开箭头，右侧按时间展开为四个共享权重 W_h 的时间步，下方红色虚线表示梯度从第 4 步倒流回第 1 步并逐级衰减">
      <title>RNN 展开与沿时间反向传播</title>
      <defs>
        <marker id="rnn-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M 0 1 L 9 5 L 0 9 z" style="fill: var(--training-accent)" />
        </marker>
        <marker id="rnn-bp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M 0 1 L 9 5 L 0 9 z" class="ru-bp--head" />
        </marker>
      </defs>

      {/* 左区：卷起来的单个循环单元 */}
      <text class="diagram-label" x="102" y="34" text-anchor="middle">卷起来看（1 个单元）</text>
      <path class="ru-loop" d="M 102 124 C 102 68, 166 68, 166 124" marker-end="url(#rnn-arrow)" />
      <text class="ru-loop-label" x="134" y="72" text-anchor="middle">记忆 h 传给下一刻</text>
      <rect class="ru-cell" x="24" y={CELL_Y} width="156" height={CELL_H} rx="8" />
      <text class="ru-cell-label" x="102" y={CELL_Y + 23} text-anchor="middle">RNN 单元</text>
      <text class="ru-cell-sub" x="102" y={CELL_Y + 42} text-anchor="middle">hₜ = φ(Wₓxₜ + Wₕhₜ₋₁)</text>
      <text class="ru-io" x="102" y={CELL_Y + CELL_H + 26} text-anchor="middle">读入当前词 xₜ</text>

      {/* 分隔与展开指示 */}
      <line class="ru-divider" x1="208" y1="54" x2="208" y2="230" />
      <text class="ru-unfold-badge" x="208" y="152" text-anchor="middle">展开 →</text>

      {/* 右区：按时间展开 */}
      <text class="diagram-label" x="468" y="34" text-anchor="middle">按时间展开（每步共用同一套权重 Wₕ）</text>
      {STEPS.map((s, i) => {
        const x = START_X + i * STEP_GAP;
        return (
          <g>
            {i > 0 && (
              <g>
                <line
                  class="ru-recurrent"
                  x1={x - (STEP_GAP - CELL_W) + 2}
                  y1={CELL_Y + CELL_H / 2}
                  x2={x - 3}
                  y2={CELL_Y + CELL_H / 2}
                  marker-end="url(#rnn-arrow)"
                />
                <text class="ru-w-label" x={x - (STEP_GAP - CELL_W) / 2} y={CELL_Y + CELL_H / 2 - 9} text-anchor="middle">Wₕ</text>
              </g>
            )}
            <text class="ru-io" x={x + CELL_W / 2} y={CELL_Y - 14} text-anchor="middle">{`词 ${s.t}：「${s.x}」`}</text>
            <rect class="ru-cell" x={x} y={CELL_Y} width={CELL_W} height={CELL_H} rx="8" />
            <text class="ru-cell-label" x={x + CELL_W / 2} y={CELL_Y + 23} text-anchor="middle">同一单元</text>
            <text class="ru-cell-sub" x={x + CELL_W / 2} y={CELL_Y + 42} text-anchor="middle">输出 {s.y}</text>
          </g>
        );
      })}

      {/* 底部：沿时间反向传播衰减箭头 */}
      {[0, 1, 2].map((i) => {
        const fromX = START_X + (3 - i) * STEP_GAP + CELL_W / 2;
        const toX = START_X + (2 - i) * STEP_GAP + CELL_W / 2 + 8;
        const y = CELL_Y + CELL_H + 34;
        return (
          <line
            class:list={['ru-bp', `ru-bp--${3 - i}`]}
            x1={fromX}
            y1={y}
            x2={toX}
            y2={y}
            marker-end="url(#rnn-bp-arrow)"
          />
        );
      })}
      <text class="ru-bp-title" x="468" y="252" text-anchor="middle">反向传梯度：从句尾一步步倒流（越往左越弱）</text>
      <text class="ru-bp-note" x="468" y="276" text-anchor="middle">每退一步就多乘一次权重与导数：小于 1 越乘越近 0（梯度消失），大于 1 越乘越爆（梯度爆炸）</text>
    </svg>
  </div>
</LessonDiagram>
