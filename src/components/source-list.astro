---
interface Source { id: string; title: string; publisher: string; url: string; publishedAt: string; accessedAt: string }
interface Props { sources: Source[] }
const { sources } = Astro.props;
---
<section class="source-list" aria-labelledby="source-list-title">
  <header class="component-heading"><p class="component-kicker">SOURCES · {String(sources.length).padStart(2, '0')}</p><h2 id="source-list-title">来源</h2></header>
  <ol>
    {sources.map((source) => (
      <li id={`source-${source.id}`}>
        <a href={source.url} rel="noreferrer">{source.title}</a>
        <span> — {source.publisher}；发布或修订：{source.publishedAt}；访问：{source.accessedAt}</span>
      </li>
    ))}
  </ol>
</section>
