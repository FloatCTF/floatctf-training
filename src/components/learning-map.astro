---
import { catalog, categoriesByOrder, completedTopics, completedTopicsByCategory, difficultyLabel, findCategory, seriesByCategory, topicsByCategory, type CatalogCategory, type CatalogTopic } from '../data/catalog';
import { withBase } from '../lib/base-url';
import { romanNumeral } from '../lib/roman-numeral';
import { Icon } from '@astrojs/starlight/components';

interface Props { categoryId?: string }
const { categoryId } = Astro.props;
const categories = (categoryId ? [findCategory(categoryId)] : categoriesByOrder()).filter(
  (category): category is CatalogCategory => Boolean(category),
).sort((a, b) => Number(completedTopicsByCategory(b.id).length > 0) - Number(completedTopicsByCategory(a.id).length > 0));
const completedTotal = completedTopics().length;
const isHomeMap = !categoryId;
const manifests = import.meta.glob('../data/lessons/*.json', { eager: true, import: 'default' }) as Record<string, { lessonPlan: { durationMinutes: number; audience: string } }>;
const planFor = (id: string) => manifests[`../data/lessons/${id}.json`]?.lessonPlan;
const sequenceLabel = (topics: { id: string; status: string; prerequisites: string[] }[]) => {
  const completed = topics.filter((topic) => topic.status === 'completed');
  if (completed.length === 0) return topics.length > 0 ? `${topics.length} 课规划中` : '规划中';
  const chained = completed.every((topic, index) => index === 0 || topic.prerequisites.includes(completed[index - 1].id));
  if (chained) return `${completed.length} 节已上线 · 按列表顺序学习`;
  return `${completed.length} 节已上线 · 先修课已标明，其余可按主题选`;
};

const panelPayload = isHomeMap
  ? categories.map((category) => {
      const topics = topicsByCategory(category.id)
        .map((topic) => ({
          id: topic.id,
          title: topic.title,
          series: topic.series ?? null,
          summary: topic.summary,
          difficulty: difficultyLabel(topic.difficulty),
          duration: planFor(topic.id)?.durationMinutes,
          status: topic.status,
          href: topic.status === 'completed' && topic.pagePath ? withBase(topic.pagePath) : null,
        }));
      const completed = topics.filter((topic) => topic.status === 'completed').length;
      return {
        id: category.id,
        name: category.name,
        summary: `${category.summary}${topics[0] && planFor(topics[0].id)?.audience ? ` 适合：${planFor(topics[0].id)?.audience}。` : ''}`,
        roman: romanNumeral(category.order),
        pagePath: withBase(category.pagePath),
        topicCount: topics.length,
        completed,
        countLabel: sequenceLabel(topicsByCategory(category.id)),
        series: seriesByCategory(category.id).map((group) => ({
          name: group.name,
          count: group.topics.length,
          completed: group.topics.filter((topic) => topic.status === 'completed').length,
        })),
        topics,
      };
    })
  : [];

type DirectoryRow =
  | { kind: 'series'; name: string; count: number; completed: number }
  | { kind: 'topic'; topic: CatalogTopic };
/** 分类页的课程列表：登记了系列的分类在每组前插入一行系列标题。 */
const directoryRows = (categoryId: string): DirectoryRow[] => {
  const groups = seriesByCategory(categoryId);
  if (groups.length === 0) return topicsByCategory(categoryId).map((topic) => ({ kind: 'topic', topic }));
  return groups.flatMap((group): DirectoryRow[] => [
    { kind: 'series', name: group.name, count: group.topics.length, completed: group.topics.filter((topic) => topic.status === 'completed').length },
    ...group.topics.map((topic): DirectoryRow => ({ kind: 'topic', topic })),
  ]);
};
---
<div
  class:list={['learning-map', { 'learning-map-single': Boolean(categoryId) }]}
  data-learning-map={isHomeMap ? 'home' : 'category'}
>
  {categories.map((category) => {
    const topics = topicsByCategory(category.id);
    const completed = topics.filter((topic) => topic.status === 'completed').length;
    const roman = romanNumeral(category.order);
    const firstTopic = topics.find((topic) => topic.status === 'completed');
    const firstPlan = firstTopic ? planFor(firstTopic.id) : undefined;
    const countLabel = sequenceLabel(topics);

    return isHomeMap ? (
      <a
        class:list={['category-directory', 'category-trigger', { 'category-planned': completed === 0 }]}
        href={withBase(category.pagePath)}
        data-category-id={category.id}
        aria-haspopup="dialog"
        aria-controls="category-panel"
      >
        <span class="category-directory-header">
          <span class="category-number" aria-hidden="true">{roman}</span>
          <span class="category-heading">
            <span class="category-title" id={`category-${category.id}`}>{category.name}</span>
            <span class="category-summary">{category.summary}</span>
            <span class="category-count">{countLabel}</span>
            {firstTopic && <span class="category-count">从《{firstTopic.title}》开始 · {firstPlan?.durationMinutes} 分钟</span>}
          </span>
          <span class="category-toggle" aria-hidden="true"><Icon name="right-arrow" size="1rem" /></span>
        </span>
      </a>
    ) : (
      <section class="category-directory category-directory-static" aria-labelledby={`category-${category.id}`}>
        <div class="category-directory-header">
          <span class="category-number" aria-hidden="true">{roman}</span>
          <span class="category-heading">
            <span class="category-title" id={`category-${category.id}`}>{category.name}</span>
            <span class="category-count">{countLabel}</span>
          </span>
        </div>
        <div class="directory-topics" id={`topics-${category.id}`}>
          {topics.length > 0 ? directoryRows(category.id).map((row) => row.kind === 'series' ? (
            <div class="directory-series">
              <h3>{row.name}</h3>
              <span>{row.completed} / {row.count} 已上线</span>
            </div>
          ) : row.topic.status === 'completed' && row.topic.pagePath ? (
            <a class="directory-topic directory-topic-completed" href={withBase(row.topic.pagePath)}>
              <span class="directory-topic-copy">
                <strong>{row.topic.title}</strong>
                <span>{row.topic.summary}</span>
              </span>
              <span class="directory-topic-meta">
                <span>{difficultyLabel(row.topic.difficulty)} · {planFor(row.topic.id)?.durationMinutes} 分钟</span>
                <Icon name="right-arrow" size="1rem" aria-hidden="true" />
              </span>
            </a>
          ) : (
            <article class="directory-topic directory-topic-planned" aria-disabled="true">
              <span class="directory-topic-copy">
                <strong>{row.topic.title}</strong>
                <span>{row.topic.summary}</span>
              </span>
              <span class="directory-topic-meta">
                <span>{difficultyLabel(row.topic.difficulty)}</span>
                <span class="directory-status">规划中</span>
              </span>
            </article>
          )) : <p class="directory-empty">本分类规划中。<a href={withBase('/')}>返回课程地图，选择已上线课程</a>。</p>}
        </div>
      </section>
    );
  })}
</div>

{isHomeMap && (
  <>
    <div class="category-panel-overlay" id="category-panel-overlay" hidden></div>
    <div
      class="category-panel"
      id="category-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="category-panel-title"
      hidden
    >
      <div class="category-panel-grabber" aria-hidden="true"></div>
      <div class="category-panel-header">
        <button type="button" class="category-panel-close" id="category-panel-close" aria-label="关闭">
          <svg viewBox="0 0 12 12" aria-hidden="true" width="12" height="12">
            <path d="M1 1l10 10M11 1L1 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
        <span class="category-panel-number" id="category-panel-roman" aria-hidden="true"></span>
        <div class="category-panel-heading">
          <h2 class="category-panel-title" id="category-panel-title"></h2>
          <p class="category-panel-summary" id="category-panel-summary"></p>
          <div class="category-panel-count" id="category-panel-count"></div>
        </div>
      </div>
      <div class="category-panel-series" id="category-panel-series" role="tablist" aria-label="系列" hidden></div>
      <div class="category-panel-body" id="category-panel-body"></div>
      <div class="category-panel-footer">
        <a class="category-panel-link" id="category-panel-link" href="#">
          查看完整分类说明
          <Icon name="right-arrow" size="1rem" aria-hidden="true" />
        </a>
      </div>
    </div>
    <script is:inline type="application/json" id="learning-map-data" set:html={JSON.stringify(panelPayload)} />
    <script is:inline>
      function initCategoryPanel() {
        const map = document.querySelector('[data-learning-map="home"]');
        const dataEl = document.getElementById('learning-map-data');
        const overlay = document.getElementById('category-panel-overlay');
        const panel = document.getElementById('category-panel');
        const panelClose = document.getElementById('category-panel-close');
        const panelSeries = document.getElementById('category-panel-series');
        const panelBody = document.getElementById('category-panel-body');
        const panelLink = document.getElementById('category-panel-link');
        const panelRoman = document.getElementById('category-panel-roman');
        const panelTitle = document.getElementById('category-panel-title');
        const panelSummary = document.getElementById('category-panel-summary');
        const panelCount = document.getElementById('category-panel-count');

        if (!map || !dataEl || !overlay || !panel || !panelClose || !panelSeries || !panelBody || !panelLink) return;
        if (map.dataset.panelReady === '1') return;
        map.dataset.panelReady = '1';

        /** @type {Array<any>} */
        let payload = [];
        try {
          payload = JSON.parse(dataEl.textContent || '[]');
        } catch {
          return;
        }

        const byId = new Map(payload.map((item) => [item.id, item]));
        let lastFocus = null;
        let sourceCard = null;
        let currentCategory = null;
        let closingTimer = null;
        let isOpen = false;
        let naturalRect = null;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        // 48rem 以下是底部抽屉，由 responsive.css 驱动，不套用卡片放大
        const canMorph = window.matchMedia('(min-width: 48.0625rem)');
        const BACK_MS = 340;

        /**
         * 量面板静止时的矩形。实测而不是假定它正好在视口中心：
         * 面板处在正文流里，外层样式随时可能给它加上 margin 或改变包含块。
         */
        function measureNaturalRect() {
          const prevTransform = panel.style.transform;
          const prevTransition = panel.style.transition;
          panel.style.transition = 'none';
          panel.style.transform = 'translate3d(-50%, -50%, 0)';
          const rect = panel.getBoundingClientRect();
          panel.style.transform = prevTransform;
          panel.style.transition = prevTransition;
          return rect;
        }

        /**
         * 把面板压成源卡片的矩形：位移取两者中心差，横竖分别缩放。
         * 落点与卡片同位置同尺寸，交接时才不会出现跳动或空档。
         */
        function cardTransform(card) {
          const pr = naturalRect;
          const cr = card.getBoundingClientRect();
          if (!pr || !pr.width || !pr.height || !cr.width || !cr.height) return '';
          const dx = cr.left + cr.width / 2 - (pr.left + pr.width / 2);
          const dy = cr.top + cr.height / 2 - (pr.top + pr.height / 2);
          return `translate3d(calc(-50% + ${dx.toFixed(2)}px), calc(-50% + ${dy.toFixed(2)}px), 0)`
            + ` scale(${(cr.width / pr.width).toFixed(4)}, ${(cr.height / pr.height).toFixed(4)})`;
        }

        function useMorph() {
          return canMorph.matches && !reduceMotion.matches;
        }

        // 有 View Transition 就交给浏览器：它对卡片和面板各拍一张快照，
        // 一边变形一边交叉淡化，文字随外框一起缩放，两端都不会出现空白面板。
        const supportsViewTransition = typeof document.startViewTransition === 'function';
        const MORPH_NAME = 'category-morph';
        let vtToken = 0;
        let morphNamed = null;

        function useViewTransition() {
          return supportsViewTransition && useMorph();
        }

        function applyOpenState(trigger) {
          overlay.hidden = false;
          panel.hidden = false;
          overlay.classList.add('is-open');
          panel.classList.add('is-open', 'is-lit');
          if (trigger) trigger.classList.add('is-source');
          document.body.classList.add('category-panel-locked');
          isOpen = true;
        }

        function applyCloseState(card) {
          panel.classList.remove('is-open', 'is-closing', 'is-animating', 'is-lit');
          panel.style.transform = '';
          overlay.classList.remove('is-open');
          overlay.hidden = true;
          panel.hidden = true;
          if (card) card.classList.remove('is-source');
          document.body.classList.remove('category-panel-locked');
          isOpen = false;
        }

        /**
         * 同一时刻只能有一个元素挂着变形用的名字，重名会让浏览器直接中止转场。
         * 用一个指针记住当前是谁，换人时先把上一个摘掉。
         */
        function setMorphName(el) {
          if (morphNamed && morphNamed !== el) morphNamed.style.viewTransitionName = '';
          morphNamed = el || null;
          if (el) el.style.viewTransitionName = MORPH_NAME;
        }

        /** 收尾。已经有更新的转场接管时交给它收，避免摘掉别人正在用的名字 */
        function endMorph(token) {
          if (token !== vtToken) return;
          setMorphName(null);
          document.documentElement.classList.remove('category-morphing');
        }

        function topicElement(topic, index) {
          const isDone = topic.status === 'completed' && topic.href;
          const el = document.createElement(isDone ? 'a' : 'article');
          el.className = `directory-topic ${isDone ? 'directory-topic-completed' : 'directory-topic-planned'}`;
          el.style.setProperty('--topic-index', String(Math.min(index, 10)));
          if (isDone) {
            el.href = topic.href;
          } else {
            el.setAttribute('aria-disabled', 'true');
          }

          const copy = document.createElement('span');
          copy.className = 'directory-topic-copy';
          const title = document.createElement('strong');
          title.textContent = topic.title;
          const summary = document.createElement('span');
          summary.textContent = topic.summary;
          copy.append(title, summary);

          const meta = document.createElement('span');
          meta.className = 'directory-topic-meta';
          const difficulty = document.createElement('span');
          difficulty.textContent = `${topic.difficulty}${topic.duration ? ` · ${topic.duration} 分钟` : ''}`;
          const trailing = document.createElement('span');
          trailing.className = isDone ? 'topic-trailing' : 'directory-status';
          trailing.textContent = isDone ? '→' : '规划中';
          meta.append(difficulty, trailing);

          el.append(copy, meta);
          return el;
        }

        function renderTopicList(topics) {
          const frag = document.createDocumentFragment();
          topics.forEach((topic, index) => frag.appendChild(topicElement(topic, index)));
          panelBody.replaceChildren(frag);
        }

        /**
         * 一次只列一个系列，面板高度不随课程总数增长。
         * 用户点切换时让新列表逐条浮入；打开面板的首次渲染由 is-lit 的错峰负责，不重复播。
         */
        function showSeries(category, name, animate) {
          panelSeries.querySelectorAll('[data-series]').forEach((button) => {
            button.setAttribute('aria-selected', String(button.dataset.series === name));
          });
          renderTopicList(category.topics.filter((topic) => topic.series === name));
          panelBody.scrollTop = 0;
          panelBody.classList.remove('is-switching');
          if (animate) {
            void panelBody.offsetWidth;
            panelBody.classList.add('is-switching');
          }
        }

        function renderTopics(category) {
          const topics = category.topics || [];
          const series = category.series || [];
          const hasSeries = series.length > 1;
          panelSeries.replaceChildren();
          panelSeries.hidden = !hasSeries;
          panelBody.classList.remove('is-switching');

          if (!topics.length) {
            const empty = document.createElement('p');
            empty.className = 'directory-empty';
            empty.textContent = '本分类规划中。可先选择已上线的学习路线：';
            panelBody.replaceChildren(empty);
            payload.filter((item) => item.completed > 0).forEach((item) => {
              const link = document.createElement('a');
              link.className = 'directory-topic';
              link.href = item.pagePath;
              link.textContent = `${item.name} · ${item.completed} 节已上线`;
              panelBody.append(link);
            });
            return;
          }

          if (!hasSeries) {
            renderTopicList(topics);
            return;
          }

          panelSeries.style.setProperty('--series-count', String(series.length));
          series.forEach((item) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.setAttribute('role', 'tab');
            button.setAttribute('aria-controls', 'category-panel-body');
            button.dataset.series = item.name;
            const name = document.createElement('b');
            name.textContent = item.name;
            const count = document.createElement('small');
            count.textContent = `${item.count} 课`;
            button.append(name, count);
            panelSeries.append(button);
          });
          // 默认停在最靠后的、已有课上线的系列：打开面板先看到能点进去的课；都没上线时停在第一个
          const initial = [...series].reverse().find((item) => item.completed > 0) || series[0];
          showSeries(category, initial.name, false);
        }

        function getFocusable() {
          return [...panel.querySelectorAll(
            'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          )].filter((el) => !el.hasAttribute('disabled') && (el.offsetParent !== null || el === panelClose));
        }

        function openPanel(categoryId, trigger) {
          const category = byId.get(categoryId);
          if (!category) return;

          if (closingTimer) {
            clearTimeout(closingTimer);
            closingTimer = null;
          }
          if (sourceCard) sourceCard.classList.remove('is-source');

          lastFocus = trigger || document.activeElement;
          sourceCard = trigger || null;
          currentCategory = category;
          panelRoman.textContent = category.roman;
          panelTitle.textContent = category.name;
          panelSummary.textContent = category.summary;
          panelCount.textContent = category.countLabel;
          panelLink.href = category.pagePath;
          renderTopics(category);

          panel.classList.remove('is-open', 'is-closing', 'is-animating', 'is-lit');
          overlay.classList.remove('is-open');

          if (useViewTransition() && sourceCard) {
            const token = ++vtToken;
            const card = sourceCard;
            setMorphName(card);
            document.documentElement.classList.add('category-morphing');
            const vt = document.startViewTransition(() => {
              setMorphName(panel);
              applyOpenState(card);
              panelClose.focus({ preventScroll: true });
            });
            vt.finished.then(() => endMorph(token), () => endMorph(token));
            return;
          }

          overlay.hidden = false;
          panel.hidden = false;
          // 先锁滚动再量：上锁会收掉滚动条并改变布局，量早了起点会偏
          document.body.classList.add('category-panel-locked');
          isOpen = true;

          naturalRect = measureNaturalRect();
          const startTransform = useMorph() && sourceCard ? cardTransform(sourceCard) : '';
          if (startTransform) {
            // 起点正好盖住卡片，所以卡片可以直接隐藏，不会露空
            panel.style.transition = 'none';
            panel.style.transform = startTransform;
            panel.classList.add('is-open');
            sourceCard.classList.add('is-source');
            void panel.offsetWidth;
            panel.style.transition = '';
          }

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              overlay.classList.add('is-open');
              panel.classList.add('is-open', 'is-lit');
              if (startTransform) {
                panel.classList.add('is-animating');
                panel.style.transform = 'translate3d(-50%, -50%, 0)';
              }
              panelClose.focus({ preventScroll: true });
            });
          });
        }

        function closePanel() {
          if (!isOpen && panel.hidden) return;

          const card = sourceCard;

          if (useViewTransition() && card) {
            const token = ++vtToken;
            if (closingTimer) {
              clearTimeout(closingTimer);
              closingTimer = null;
            }
            setMorphName(panel);
            document.documentElement.classList.add('category-morphing');
            const restore = lastFocus;
            const vt = document.startViewTransition(() => {
              setMorphName(card);
              applyCloseState(card);
              if (restore && typeof restore.focus === 'function') {
                restore.focus({ preventScroll: true });
              }
            });
            lastFocus = null;
            sourceCard = null;
            vt.finished.then(() => endMorph(token), () => endMorph(token));
            return;
          }

          isOpen = false;
          overlay.classList.remove('is-open');
          const finish = () => {
            panel.style.transition = 'none';
            panel.classList.remove('is-open', 'is-closing', 'is-animating', 'is-lit');
            // 与上一行同帧执行：面板撤下的瞬间卡片就回来，中间没有空档
            if (card) card.classList.remove('is-source');
            panel.style.transform = '';
            overlay.hidden = true;
            panel.hidden = true;
            // 滚动锁留到最后一刻解开，行程全程都在同一套布局里量
            document.body.classList.remove('category-panel-locked');
            requestAnimationFrame(() => {
              panel.style.transition = '';
            });
            if (lastFocus && typeof lastFocus.focus === 'function') {
              lastFocus.focus({ preventScroll: true });
            }
            lastFocus = null;
            sourceCard = null;
            closingTimer = null;
          };

          if (reduceMotion.matches) {
            finish();
            return;
          }

          panel.classList.remove('is-animating');
          panel.classList.add('is-closing');

          const backTransform = useMorph() && card ? cardTransform(card) : '';
          if (backTransform) {
            panel.style.transform = backTransform;
          }

          closingTimer = window.setTimeout(finish, BACK_MS);
        }

        map.addEventListener('click', (event) => {
          const trigger = event.target.closest('.category-trigger');
          if (!trigger || !map.contains(trigger)) return;
          const categoryId = trigger.getAttribute('data-category-id');
          if (!categoryId || !byId.has(categoryId)) return;
          event.preventDefault();
          openPanel(categoryId, trigger);
        });

        panelClose.addEventListener('click', closePanel);
        overlay.addEventListener('click', closePanel);

        panelSeries.addEventListener('click', (event) => {
          const button = event.target.closest('[data-series]');
          if (!button || !currentCategory || button.getAttribute('aria-selected') === 'true') return;
          showSeries(currentCategory, button.dataset.series, true);
        });

        // 方向键在系列之间移动并直接切换，与标签页的键盘习惯一致
        panelSeries.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          const buttons = [...panelSeries.querySelectorAll('[data-series]')];
          const index = buttons.indexOf(document.activeElement);
          if (index < 0 || !currentCategory) return;
          event.preventDefault();
          const target = buttons[(index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length];
          target.focus();
          showSeries(currentCategory, target.dataset.series, true);
        });

        // 开着面板时改窗口大小，静止矩形会变，收起前重新量一次
        window.addEventListener('resize', () => {
          if (isOpen) naturalRect = measureNaturalRect();
        });

        document.addEventListener('keydown', (event) => {
          if (!isOpen) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            closePanel();
            return;
          }
          if (event.key === 'Tab') {
            const focusable = getFocusable();
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });
      }

      initCategoryPanel();
    </script>
