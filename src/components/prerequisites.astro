---
import NumberedBox from './numbered-box.astro';
import { findTopic } from '../data/catalog';
import { withBase } from '../lib/base-url';

interface Props { items: string[] }
const { items } = Astro.props;
---

<NumberedBox class="prerequisites" number="02" title="前置知识" titleId="prerequisites-title">
  <ul>{items.map((item) => {
    const topic = findTopic(item);
    return <li>{topic?.pagePath ? <a href={withBase(topic.pagePath)}>{topic.title}</a> : item}</li>;
  })}</ul>
</NumberedBox>
