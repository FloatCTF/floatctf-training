---
interface Box { x: number; y: number; w: number; h: number; label: string; sub?: string; kind?: 'doc' | 'proc' | 'store' | 'model' }
const W = 136;
const H = 64;
const xs = [18, 186, 354, 522];
const lane1: Box[] = [
  { x: xs[0], y: 72, w: W, h: H, label: '1. 原始文档', sub: 'PDF / Wiki / 工单', kind: 'doc' },
  { x: xs[1], y: 72, w: W, h: H, label: '2. 切段', sub: 'Chunking 按段切开', kind: 'proc' },
  { x: xs[2], y: 72, w: W, h: H, label: '3. 转向量', sub: 'Embedding 编码', kind: 'proc' },
  { x: xs[3], y: 72, w: W, h: H, label: '4. 向量索引', sub: '存入向量库（HNSW）', kind: 'store' },
];
const lane2: Box[] = [
  { x: xs[0], y: 236, w: W, h: H, label: '1. 用户提问', sub: '输入查询问题', kind: 'doc' },
  { x: xs[1], y: 236, w: W, h: H, label: '2. 问题转向量', sub: '用同一套编码模型', kind: 'proc' },
  { x: xs[2], y: 236, w: W, h: H, label: '3. 查最像段落', sub: '向量库召回 top-k', kind: 'proc' },
  { x: xs[3], y: 236, w: W, h: H, label: '4. 精排重排', sub: 'Rerank 挑出真证据', kind: 'proc' },
];
const gen: Box = { x: xs[3], y: 356, w: W, h: H, label: '5. 模型作答', sub: '证据拼进上下文', kind: 'model' };
const straightArrows: [number, number, number, number][] = [
  [xs[0] + W, 104, xs[1] - 3, 104],
  [xs[1] + W, 104, xs[2] - 3, 104],
  [xs[2] + W, 104, xs[3] - 3, 104],
  [xs[0] + W, 268, xs[1] - 3, 268],
  [xs[1] + W, 268, xs[2] - 3, 268],
  [xs[2] + W, 268, xs[3] - 3, 268],
  [xs[3] + W / 2, 300, xs[3] + W / 2, 353],
];
import LessonDiagram from './lesson-diagram.astro';
---
<LessonDiagram
  eyebrow="RAG PIPELINE / 两条线"
  title="RAG 拆开就两条线：离线建索引，在线查资料"
  ariaLabel="RAG 管线图"
  note="资料变了只需要重跑上面那条入库线，不用重新训练大模型。下面查询时，先从向量索引捞出最相近的 top-k 片段，再重排送给模型作答。"
>
  <svg viewBox="0 0 676 440" role="img" aria-label="RAG 管线：上行为离线入库（文档切段、转向量、存入向量索引），向量索引连接到下行的查最像段落（top-k 召回），随后精排重排并交给模型作答">
    <title>RAG 管线图</title>
    <defs>
      <marker id="rag-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 1 L 9 5 L 0 9 z" class="diagram-arrow-head" />
      </marker>
      <marker id="rag-store-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 1 L 9 5 L 0 9 z" style="fill: var(--training-class-zero)" />
      </marker>
    </defs>

    <text x="18" y="48" class="diagram-lane-label">离线入库（文档更新时跑一次）</text>
    <text x="18" y="212" class="diagram-lane-label">在线查询（用户每次提问都跑一遍）</text>

    {straightArrows.map(([x1, y1, x2, y2]) => (
      <line x1={x1} y1={y1} x2={x2} y2={y2} class="diagram-arrow" marker-end="url(#rag-arrow)" />
    ))}

    {/* 向量索引 (xs[3]+W/2=590, bottom=136) 正确指向 查最像段落 (xs[2]+W/2=422, top=236) */}
    <path
      d={`M ${xs[3] + W / 2} 136 L ${xs[3] + W / 2} 174 L ${xs[2] + W / 2} 174 L ${xs[2] + W / 2} 233`}
      class="diagram-arrow"
      style="stroke: var(--training-class-zero); stroke-dasharray: 5 4;"
      marker-end="url(#rag-store-arrow)"
      fill="none"
    />
    <text x={(xs[2] + xs[3] + W) / 2} y="166" text-anchor="middle" class="diagram-lane-label" style="fill: var(--training-class-zero); font-size: 12.5px; font-weight: 700;">提供相似度检索</text>

    {[...lane1, ...lane2, gen].map((b) => (
      <g>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="10" class={`diagram-box diagram-box--${b.kind ?? 'proc'}`} />
        <text x={b.x + b.w / 2} y={b.y + 26} text-anchor="middle" class="diagram-box-label" style="font-size: 14.5px;">{b.label}</text>
        {b.sub && <text x={b.x + b.w / 2} y={b.y + 47} text-anchor="middle" class="diagram-box-sub" style="font-size: 12px;">{b.sub}</text>}
      </g>
    ))}
  </svg>
</LessonDiagram>
