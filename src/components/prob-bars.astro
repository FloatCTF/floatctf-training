---
interface Candidate { token: string; percent: number }
interface Scenario { context: string; candidates: Candidate[] }
interface Props { scenarios: Scenario[]; note?: string }
const { scenarios, note = '示意：固定权重，用来理解“上下文改变下一词分布”。真实模型会在全词表上计算概率。' } = Astro.props;
---
<section class="prob-bars not-content" aria-label="概率分布示意">
  {scenarios.map((scenario) => (
    <div class="prob-bars-block">
      <p class="prob-bars-context">{scenario.context}</p>
      <ul class="prob-bars-list">
        {scenario.candidates.map((item) => (
          <li class="prob-bars-row">
            <span class="prob-bars-token">{item.token}</span>
            <span class="prob-bars-track" aria-hidden="true">
              <span class="prob-bars-fill" style={`width: ${item.percent}%`}></span>
            </span>
            <span class="prob-bars-percent">{item.percent.toFixed(1)}%</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
  <p class="prob-bars-note">{note}</p>
</section>
