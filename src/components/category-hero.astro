---
import { findCategory } from '../data/catalog';
import { withBase } from '../lib/base-url';
import { romanNumeral } from '../lib/roman-numeral';
import { Icon } from '@astrojs/starlight/components';

interface Props { title: string; description?: string; entryId: string }
const { title, description, entryId } = Astro.props;
const categoryId = entryId.startsWith('categories/') ? entryId.split('/')[1] : undefined;
const category = findCategory(categoryId);
const number = category ? romanNumeral(category.order) : '00';
const summary = category?.summary || description || '按学科方向查看课程状态与学习路线。';
---

<header class="category-hero" aria-labelledby="_top">
  <nav class="category-path" aria-label="分类路径">
    <a href={withBase('/')}><Icon name="left-arrow" size="1rem" aria-hidden="true" />课程地图</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{title}</span>
  </nav>
  <div class="category-hero-heading">
    <span class="category-hero-number" aria-hidden="true">{number}</span>
    <div>
      <p class="category-hero-kicker">CURRICULUM CATEGORY</p>
      <h1 id="_top">{category?.name || title}</h1>
      <p>{summary}</p>
    </div>
  </div>
</header>
