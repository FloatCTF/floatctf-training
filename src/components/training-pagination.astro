---
import { Icon } from '@astrojs/starlight/components';
import { completedTopicsByCategory, findCategory, findTopic } from '../data/catalog';
import { withBase } from '../lib/base-url';

const route = (Astro.locals as unknown as {
  starlightRoute: { entry: { id: string }; dir?: string };
}).starlightRoute;
const entryId = String(route.entry.id);
const dir = route.dir;

interface PageLink {
  href: string;
  label: string;
}

let prev: PageLink | undefined;
let next: PageLink | undefined;
let endNote = '';

if (entryId.startsWith('lessons/')) {
  const lessonId = entryId.replace(/^lessons\//, '');
  const topic = findTopic(lessonId);
  const category = topic ? findCategory(topic.categoryId) : undefined;
  const siblings = topic ? completedTopicsByCategory(topic.categoryId) : [];
  const index = siblings.findIndex((item) => item.id === lessonId);
  const previousTopic = index > 0 ? siblings[index - 1] : undefined;
  const nextTopic = index >= 0 ? siblings[index + 1] : undefined;
  if (previousTopic?.pagePath) {
    prev = { href: withBase(previousTopic.pagePath), label: previousTopic.title };
  } else if (category) {
    prev = { href: withBase(category.pagePath), label: category.name };
  }
  if (nextTopic?.pagePath) {
    next = { href: withBase(nextTopic.pagePath), label: nextTopic.title };
  } else if (category) {
    endNote = `《${category.name}》已上线的课到这里。显示为规划中的分类还没有可进入的课。`;
  }
}
---

{(prev || next || endNote) && (
  <div class="pagination-links print:hidden" dir={dir}>
    {prev && (
      <a href={prev.href} rel="prev">
        <Icon name="left-arrow" size="1.5rem" />
        <span>
          上一课
          <br />
          <span class="link-title">{prev.label}</span>
        </span>
      </a>
    )}
    {next && (
      <a href={next.href} rel="next">
        <Icon name="right-arrow" size="1.5rem" />
        <span>
          下一课
          <br />
          <span class="link-title">{next.label}</span>
        </span>
      </a>
    )}
    {endNote && <p class="pagination-end">{endNote}</p>}
  </div>
)}

<style>
  .pagination-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1rem;
    margin-block: 2rem;
  }
  a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--training-border);
    padding: 1rem;
    text-decoration: none;
    color: var(--training-text);
    overflow-wrap: anywhere;
  }
  [rel='next'] {
    justify-content: end;
    text-align: end;
    flex-direction: row-reverse;
  }
  .link-title {
    color: var(--training-heading);
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .pagination-end {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--training-border);
  }
</style>
