---
interface Node { x: number; y: number; w: number; h: number; label: string; kind?: 'start' | 'proc' | 'join' | 'human' | 'end' }
const nodes: Node[] = [
  { x: 270, y: 16, w: 140, h: 40, label: '确认版本范围', kind: 'start' },
  { x: 170, y: 100, w: 120, h: 40, label: '读取 commits' },
  { x: 390, y: 100, w: 120, h: 40, label: '读取 blockers' },
  { x: 270, y: 184, w: 140, h: 40, label: '生成草稿', kind: 'join' },
  { x: 120, y: 268, w: 110, h: 40, label: '安全审查' },
  { x: 285, y: 268, w: 110, h: 40, label: '证据审查' },
  { x: 450, y: 268, w: 110, h: 40, label: '格式审查' },
  { x: 270, y: 352, w: 140, h: 40, label: '汇总', kind: 'join' },
  { x: 270, y: 436, w: 140, h: 40, label: '人工确认', kind: 'human' },
  { x: 300, y: 520, w: 80, h: 36, label: 'END', kind: 'end' },
];
const node = (label: string) => nodes.find((n) => n.label === label)!;
const c = (n: Node) => ({ cx: n.x + n.w / 2, cy: n.y + n.h / 2 });
const edge = (from: string, to: string) => {
  const a = node(from); const b = node(to);
  const ca = c(a); const cb = c(b);
  if (Math.abs(ca.cx - cb.cx) < 2 || ca.cy < cb.cy) {
    return { x1: ca.cx, y1: a.y + a.h, x2: cb.cx, y2: b.y };
  }
  return { x1: ca.cx, y1: a.y, x2: cb.cx, y2: b.y + b.h };
};
const solidEdges: [string, string][] = [
  ['确认版本范围', '读取 commits'],
  ['确认版本范围', '读取 blockers'],
  ['读取 commits', '生成草稿'],
  ['读取 blockers', '生成草稿'],
  ['生成草稿', '安全审查'],
  ['生成草稿', '证据审查'],
  ['生成草稿', '格式审查'],
  ['安全审查', '汇总'],
  ['证据审查', '汇总'],
  ['格式审查', '汇总'],
  ['汇总', '人工确认'],
  ['人工确认', 'END'],
];
const edgeCoords = solidEdges.map(([from, to]) => edge(from, to));
---
<section class="lesson-diagram not-content" aria-label="发布简报执行图">
  <p class="lesson-diagram__eyebrow">EXECUTION GRAPH / 节点与边</p>
  <h3 class="lesson-diagram__title">一张图同时容纳并行、汇合与回边</h3>
  <svg viewBox="0 0 680 580" role="img" aria-label="执行图：确认版本范围后并行读取提交与阻断项，生成草稿后并行进行安全、证据、格式三路审查，汇总通过后人工确认结束；审查失败带反馈回到生成草稿。">
    <title>发布简报执行图</title>
    <defs>
      <marker id="exec-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="diagram-arrow-head" />
      </marker>
    </defs>
    <text x="512" y="462" class="diagram-lane-label">PASS</text>
    <path d="M 270 372 C 170 372, 150 300, 220 250, 260 228, 290 226, 320 224" class="diagram-arrow diagram-arrow--fail" marker-end="url(#exec-arrow)" fill="none" />
    <text x="96" y="300" class="diagram-lane-label diagram-lane-label--fail">FAIL 带反馈</text>
    {edgeCoords.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="diagram-arrow" marker-end="url(#exec-arrow)" />
    ))}
    {nodes.map((n) => (
      <g>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" class={`diagram-box diagram-box--${n.kind ?? 'proc'}`} />
        <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 5} text-anchor="middle" class="diagram-box-label">{n.label}</text>
      </g>
    ))}
  </svg>
  <p class="lesson-diagram__note">读取与审查是并行节点，汇合点等待全部完成；虚线回边表示审查失败后带反馈重新生成草稿，发布动作保留给人工节点。</p>
</section>
