---
// 数据流水线总览：五个环节 + 一条被禁止的泄漏路径
const STAGES = [
  { n: '1', title: '收集与打标', note: '找齐带答案的例子' },
  { n: '2', title: '清洗去脏', note: '处理缺失、重复和错标' },
  { n: '3', title: '切分数据', note: '拆出训练 / 验证 / 测试集' },
  { n: '4', title: '拟合预处理', note: '缩放、编码；只在训练集学规则' },
  { n: '5', title: '独立考试', note: '用没见过的题检验上线效果' },
];
const NODE_W = 110;
const GAP = 22;
const START_X = 16;
const Y = 34;
const MID_Y = Y + 25;
// 泄漏曲线从节点 5 底部绕回节点 4（拟合预处理）底部，避开 y=94..136 的说明文字
const LEAK_START_X = START_X + 4 * (NODE_W + GAP) + NODE_W / 2;
const LEAK_END_X = START_X + 3 * (NODE_W + GAP) + NODE_W / 2;
import LessonDiagram from './lesson-diagram.astro';
---
<LessonDiagram
  eyebrow="DATA PIPELINE / 环节与红线"
  title="数据怎么一步步走进模型"
  ariaLabel="数据流水线与泄漏路径总览"
  class="data-pipeline"
  headered
  note="记住一条铁律：先切分（第 3 步），再只在训练集上算均值、词表和缩放规则（第 4 步）。测试集一旦倒流进前面任何一步，离线分数就会虚高。"
  noteClass="data-pipeline__note"
>
  <div class="data-pipeline__body">
    <svg viewBox="0 0 676 238" role="img" aria-label="五个环节依次连接：收集与打标、清洗去脏、切分数据、拟合预处理、独立考试；一条红色虚线在说明文字下方从独立考试绕回拟合预处理，标注为数据泄漏禁止路径">
      <title>数据流水线与泄漏路径</title>
      <defs>
        <marker id="dp-flow-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M 0 1 L 9 5 L 0 9 z" class="diagram-arrow-head" />
        </marker>
        <marker id="dp-leak-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M 0 1 L 9 5 L 0 9 z" class="dp-leak--head" />
        </marker>
      </defs>
      {STAGES.map((s, i) => {
        const x = START_X + i * (NODE_W + GAP);
        return (
          <g>
            <rect class="dp-node" x={x} y={Y} width={NODE_W} height="50" rx="8" />
            <text class="dp-node__n" x={x + 12} y={Y + 21}>{s.n}</text>
            <text class="dp-node__title" x={x + NODE_W / 2 + 5} y={Y + 31} text-anchor="middle">{s.title}</text>
            <foreignObject x={x - 3} y={Y + 60} width={NODE_W + 6} height="48">
              <div class="dp-node__note">{s.note}</div>
            </foreignObject>
            {i < STAGES.length - 1 && (
              <line
                class="diagram-arrow"
                x1={x + NODE_W + 2}
                y1={MID_Y}
                x2={x + NODE_W + GAP - 3}
                y2={MID_Y}
                marker-end="url(#dp-flow-arrow)"
              />
            )}
          </g>
        );
      })}
      <path
        class="dp-leak"
        d={`M ${LEAK_START_X} 148 C ${LEAK_START_X} 198, ${LEAK_END_X} 198, ${LEAK_END_X} 152`}
        marker-end="url(#dp-leak-arrow)"
      />
      <text class="dp-leak-label" x="656" y="220" text-anchor="end">
        禁止红线：测试集信息绕回训练侧 = 考试泄题（数据泄漏）
      </text>
    </svg>
  </div>
</LessonDiagram>
