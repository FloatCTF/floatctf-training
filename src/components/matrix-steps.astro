---
// 手算一遍两层之间的加权求和：2 个输入 → 2 个隐藏神经元，数字全部可验算
const INPUTS = [
  { label: 'x₁', value: '1.0', y: 92 },
  { label: 'x₂', value: '0.5', y: 222 },
];

const HIDDEN = [
  {
    label: 'h₁', bias: '+0.1', y: 92,
    calc: 'z₁ = 0.5×1.0 + (−0.8)×0.5 + 0.1 = 0.2',
    act: 'a₁ = ReLU(0.2) = 0.2（正数放行）',
  },
  {
    label: 'h₂', bias: '−0.3', y: 222,
    calc: 'z₂ = (−0.4)×1.0 + 0.6×0.5 + (−0.3) = −0.4',
    act: 'a₂ = ReLU(−0.4) = 0（负数归零）',
  },
];

// 每条连线的标签放在靠近出发点或非交叉处，并加白底胶囊避免任何压线歧义
const WIRES = [
  { from: 92, to: 92, weight: 'w₁ = +0.5', lx: 255, ly: 76, positive: true },
  { from: 222, to: 92, weight: 'w₂ = −0.8', lx: 318, ly: 132, positive: false },
  { from: 92, to: 222, weight: 'w₃ = −0.4', lx: 192, ly: 132, positive: false },
  { from: 222, to: 222, weight: 'w₄ = +0.6', lx: 255, ly: 244, positive: true },
];
---

<section class="matrix-steps not-content" aria-label="手算两层之间的加权求和">
  <header class="matrix-steps__header">
    <p class="lesson-diagram__eyebrow">手算 / 公式落到数字</p>
    <h3 class="lesson-diagram__title">把 z = w₁x₁ + w₂x₂ + b 完整算一遍</h3>
    <p class="matrix-steps__intro">取 x₁ = 1.0、x₂ = 0.5，两层各两个节点。红线是正权重，蓝线是负权重，圆圈里标的是偏置 b。</p>
  </header>
  <p class="matrix-steps__scroll-hint">横向滑动可查看完整节点与计算式 <span aria-hidden="true">→</span></p>
  <div class="matrix-steps__body" tabindex="0" aria-label="可横向滚动的加权求和完整示意图">
    <svg viewBox="0 0 840 306" role="img" aria-label="两个输入经四条带正负色连线汇入两个隐藏神经元，每条线的权重带白底标签清晰标出">
      <title>加权求和示意图</title>
      {WIRES.map((w) => (
        <line
          class:list={['ms-wire', w.positive ? 'ms-wire--pos' : 'ms-wire--neg']}
          x1="124" y1={w.from} x2="394" y2={w.to}
        />
      ))}
      {WIRES.map((w) => (
        <g>
          <rect
            class:list={['ms-pill', w.positive ? 'ms-pill--pos' : 'ms-pill--neg']}
            x={w.lx - 42}
            y={w.ly - 13}
            width="84"
            height="22"
            rx="11"
          />
          <text
            class:list={['ms-weight', w.positive ? 'ms-weight--pos' : 'ms-weight--neg']}
            x={w.lx}
            y={w.ly + 2}
            text-anchor="middle"
          >
            {w.weight}
          </text>
        </g>
      ))}
      {INPUTS.map((n) => (
        <g>
          <circle class="ms-node" cx="90" cy={n.y} r="34" />
          <text class="ms-node-label" x="90" y={n.y - 6} text-anchor="middle">{n.label}</text>
          <text class="ms-node-value" x="90" y={n.y + 16} text-anchor="middle">{n.value}</text>
        </g>
      ))}
      {HIDDEN.map((n) => (
        <g>
          <circle class="ms-node ms-node--hidden" cx="428" cy={n.y} r="34" />
          <text class="ms-node-label" x="428" y={n.y - 6} text-anchor="middle">{n.label}</text>
          <text class="ms-node-value" x="428" y={n.y + 16} text-anchor="middle">b {n.bias}</text>
          <text class="ms-calc" x="480" y={n.y - 6}>{n.calc}</text>
          <text class="ms-act" x="480" y={n.y + 18}>{n.act}</text>
        </g>
      ))}
    </svg>
  </div>
  <div class="matrix-steps__mobile-ledger" aria-label="两个隐藏单元的计算明细">
    {HIDDEN.map((n) => (
      <article>
        <strong>{n.label}</strong>
        <code>{n.calc}</code>
        <span>{n.act}</span>
      </article>
    ))}
  </div>
  <p class="lesson-diagram__note matrix-steps__note">
    把成百上千个样本的同类加权求和打包写成一张表，就是矩阵乘法 W·x + b。矩阵并不是新概念，只是让 GPU 一次算完几千份打分表的批量记账法。
  </p>
</section>
