    {
      "id": "evidence-jenkins",
      "kind": "cve",
      "identifier": "CVE-2023-27898",
      "topicRelation": "direct",
      "sourceIds": [
        "cve-2023-27898",
        "jenkins-cve-2023-27898"
      ],
      "summary": "Jenkins 2.270–2.393 与 LTS 2.277.1–2.375.3 未转义插件依赖的 Jenkins 版本错误消息；能向已配置更新站点提供插件并让实例显示该消息的攻击者可触发存储型 XSS。2.394、LTS 2.375.4 与 2.387.1 已修复。"
    },
    {
      "id": "evidence-hibernate",
      "kind": "cve",
      "identifier": "CVE-2023-1932",
      "topicRelation": "direct",
      "sourceIds": [
        "cve-2023-1932",
        "nvd-cve-2023-1932"
      ],
      "summary": "Hibernate Validator 的 SafeHtmlValidator.isValid 可被省略标签结束小于号的输入绕过；浏览器可能继续渲染该无效 HTML，形成 HTML 注入或 XSS。"
    }
  ],
  "claims": [
    {
      "id": "claim-definition",
