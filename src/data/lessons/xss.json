  "interviewQuestions": [
    {
      "id": "interview-q1",
      "question": "你会怎么修复 XSS？",
      "level": 1,
      "answer": "按输出上下文做正确编码或使用安全模板 API，避免把不可信数据直接插入 HTML、JS 或事件处理器。",
      "keyPoints": [
        "上下文编码",
        "安全模板",
        "禁止危险插入"
      ],
      "bonus": "OWASP 按上下文给出规则。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-xss-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-xss-prevention"
      ]
    },
    {
      "id": "interview-q2",
      "question": "如何修复 DOM XSS？",
      "level": 1,
      "answer": "避免把不可信数据赋给危险汇点如 innerHTML 与 document.write，改用 textContent 或经过审查的安全 API，并校验 URL 协议。",
      "keyPoints": [
        "危险汇点",
        "安全 API",
        "URL 协议"
      ],
      "bonus": "DOM XSS 的源常在 location、postMessage 与前端存储。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-xss-prevention",
        "cwe-79"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-xss-prevention",
        "cwe-79"
      ]
    },
    {
      "id": "interview-q3",
      "question": "反射型、存储型、DOM 型 XSS 的数据流差在哪里？",
      "level": 2,
      "answer": "反射型在当次响应回显；存储型先入库再被多人读取；DOM 型在浏览器端由脚本读入并写入危险汇点。",
      "keyPoints": [
        "响应回显",
        "持久化",
        "纯前端链路"
      ],
      "bonus": "同一业务可能同时存在多条路径。",
      "sourceIds": [
        "tib3rius-interview",
        "cwe-79"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "cwe-79"
      ]
    },
    {
      "id": "interview-q4",
      "question": "为什么“统一 HTML 编码”不够？",
      "level": 2,
      "answer": "输出到 JavaScript 字符串、HTML 属性、URL 或 CSS 时，需要不同的编码规则；用错上下文仍可执行。",
      "keyPoints": [
        "多上下文",
        "规则不同",
        "错配仍危险"
      ],
      "bonus": "编码点应靠近输出；入口过滤承担独立的数据校验职责。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-xss-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-xss-prevention"
      ]
    },
    {
      "id": "interview-q5",
      "question": "CSP 能替代输出编码吗？",
      "level": 3,
      "answer": "输出上下文编码与安全汇点承担主控制，阻止输入成为代码；CSP 作为纵深防御，限制脚本来源与危险特性。",
      "keyPoints": [
        "CSP 是附加层",
        "编码是主控制",
        "两者互补"
      ],
      "bonus": "宽松 CSP 或含不安全指令时保护显著下降。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-xss-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-xss-prevention"
      ]
    },
    {
      "id": "interview-q6",
      "question": "HttpOnly Cookie 解决了什么、没解决什么？",
      "level": 3,
      "answer": "HttpOnly 降低脚本直接读 Cookie 的能力，但不阻止页面被篡改、钓鱼表单或其它敏感操作被代发。",
      "keyPoints": [
        "降低读 Cookie",
        "不阻止页面篡改",
        "需配合其它控制"
      ],
      "bonus": "还应设置 Secure 与 SameSite 等属性。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-xss-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-xss-prevention"
      ]
    },
    {
      "id": "interview-q7",
      "question": "代码评审看到 `preview.innerHTML = new URLSearchParams(location.search).get('msg')`，你会怎样处理？",
      "level": 4,
      "answer": "确认数据是否不可信，要求改为 textContent 或经过消毒且默认安全的渲染路径，并补充针对该汇点的回归测试。",
      "keyPoints": [
        "汇点识别",
        "安全替换",
        "回归测试"
      ],
      "bonus": "同步搜索相邻的 outerHTML、insertAdjacentHTML 与动态脚本创建。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-xss-prevention",
        "cwe-79"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-xss-prevention",
        "cwe-79"
      ]
    },
    {
      "id": "interview-q8",
      "question": "授权测试中如何证明 XSS 影响并推动修复？",
      "level": 4,
      "answer": "在授权测试环境用无害载荷证明 DOM 改写，记录输入源、转换过程和危险汇点；优先替换危险汇点或实施上下文编码，再收紧 CSP 并回归相关页面。",
      "keyPoints": [
        "无害证明",
        "源汇点路径",
        "修复回归"
      ],
      "bonus": "Jenkins 案例要求攻击者控制已配置更新站点返回的错误消息；Hibernate Validator 案例源于 SafeHtmlValidator 对不完整标签的校验绕过。",
