  "claims": [
    {
      "id": "claim-prepare",
      "text": "参数化 API 分别传递语句模板与参数，使参数按数据值处理，无法改写关键字、操作符或子句结构；数据库可根据实现与数据选择执行计划。",
      "sourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "claim-identifier",
      "text": "标识符位置（如 ORDER BY 列名）通常不能参数化，需要允许列表。",
      "sourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "claim-second-order",
      "text": "二次注入发生在先存储、后拼接的路径上，首次校验通过不代表后续使用安全。",
      "sourceIds": [
        "cwe-89"
      ]
    }
  ],
