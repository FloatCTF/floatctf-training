  "interviewQuestions": [
    {
      "id": "interview-q1",
      "question": "参数化查询和“手动转义输入”有什么本质差别？",
      "level": 1,
      "answer": "参数化把输入作为数据绑定进已编译结构；转义只是尝试让输入在某一上下文看起来安全，仍依赖编码与上下文判断正确。",
      "keyPoints": [
        "结构绑定 vs 字符处理",
        "上下文依赖",
        "主防线不同"
      ],
      "bonus": "OWASP 将转义视为最后手段。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q2",
      "question": "为什么说“用了 ORM 就一定没有 SQL 注入”不成立？",
      "level": 1,
      "answer": "ORM 在提供安全 API 的同时也常暴露原始 SQL、字符串模板或动态排序拼接，误用这些接口仍会注入。",
      "keyPoints": [
        "ORM 也有原始查询",
        "动态拼接风险",
        "API 选择决定安全"
      ],
      "bonus": "审计应搜索 raw、extra、${} 等危险模式。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention",
        "cwe-89"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention",
        "cwe-89"
      ]
    },
    {
      "id": "interview-q3",
      "question": "真预编译和模拟预编译差在哪里？",
      "level": 2,
      "answer": "真预编译在数据库侧固定执行计划与结构；模拟预编译常在客户端转义后仍发送完整 SQL 文本，边界更依赖驱动实现。",
      "keyPoints": [
        "服务端结构固定",
        "客户端模拟",
        "驱动差异"
      ],
      "bonus": "配置错误时“看起来像预编译”仍可能拼接。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q4",
      "question": "ORDER BY 为什么经常成为参数化盲区？",
      "level": 2,
      "answer": "排序字段是标识符而不是字面量值，占位符不能像值那样绑定列名，因此必须用允许列表映射到已知列。",
      "keyPoints": [
        "标识符非值",
        "不能直接占位",
        "白名单映射"
      ],
      "bonus": "同类问题还包括动态表名与列名。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q5",
      "question": "如何在代码审计中快速定位高风险 SQL 构造？",
      "level": 3,
      "answer": "搜索字符串拼接、格式化字符串、原始查询 API 与模板占位差异，再沿输入来源确认是否可达外部数据。",
      "keyPoints": [
        "危险 API 清单",
        "数据流可达性",
        "动态标识符"
      ],
      "bonus": "同时检查存储后再次拼进语句的二次路径。",
      "sourceIds": [
        "appsec-interview-gist",
        "cwe-89",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cwe-89",
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q6",
      "question": "生产环境除了改代码，还应补哪些控制？",
      "level": 3,
      "answer": "数据库最小权限、禁用高危过程、收敛错误回显、WAF/检测规则与异常查询审计，形成不依赖单一点的控制链。",
      "keyPoints": [
        "权限",
        "回显",
        "检测"
      ],
      "bonus": "控制链要能在代码回归后继续提供告警。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q7",
      "question": "面试时如何解释“预编译为什么能防注入”？",
      "level": 4,
      "answer": "先说明语句在绑定前完成词法语法分析并固定 AST，再说明参数只替换叶子值，最后指出标识符位置仍需白名单。",
      "keyPoints": [
        "AST 固定",
        "值绑定",
        "标识符例外"
      ],
      "bonus": "能画出“拼接改树 / 绑定不改树”对照的人通常更清楚。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q8",
      "question": "若业务必须动态拼排序与筛选，你会怎样设计安全接口？",
      "level": 4,
      "answer": "把允许的列名与操作符做成服务端枚举映射，值继续参数化，拒绝未知字段，并对生成 SQL 做单测覆盖恶意标识符。",
      "keyPoints": [
        "枚举映射",
        "值参数化",
        "未知拒绝"
      ],
      "bonus": "把映射表当作安全边界文档，而不是散落在各处的 if。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention",
        "cwe-89"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention",
        "cwe-89"
      ]
    }
  ]
