  "interviewQuestions": [
    {
      "id": "interview-q1",
      "question": "参数化查询和“手动转义输入”有什么本质差别？",
      "level": 1,
      "answer": "参数化把输入作为数据绑定进已编译结构；转义只是尝试让输入在某一上下文看起来安全，仍依赖编码与上下文判断正确。",
      "keyPoints": [
        "结构绑定与字符处理",
        "上下文依赖",
        "主防线不同"
      ],
      "bonus": "OWASP 将转义视为最后手段。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q2",
      "question": "ORM 项目仍需审计哪些 SQL 注入入口？",
      "level": 1,
      "answer": "ORM 在提供安全 API 的同时也常暴露原始 SQL、字符串模板或动态排序拼接，误用这些接口仍会注入。",
      "keyPoints": [
        "ORM 也有原始查询",
        "动态拼接风险",
        "API 选择决定安全"
      ],
      "bonus": "审计应搜索 raw、extra、${} 等危险模式。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention",
        "cwe-89"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention",
        "cwe-89"
      ]
    },
    {
      "id": "interview-q3",
      "question": "真预编译和模拟预编译差在哪里？",
      "level": 2,
      "answer": "服务端预处理通常由数据库分别接收语句与绑定值；模拟预处理可能由客户端驱动转义参数后生成完整 SQL 文本，安全边界取决于驱动实现、配置与字符编码。",
      "keyPoints": [
        "服务端分别接收语句和值",
        "客户端模拟",
        "驱动差异"
      ],
      "bonus": "审计时应查阅具体驱动文档并验证配置，避免仅凭 API 名称判断。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q4",
      "question": "ORDER BY 为什么经常成为参数化盲区？",
      "level": 2,
      "answer": "排序字段属于标识符，值占位符无法绑定列名，因此必须用允许列表映射到已知列。",
      "keyPoints": [
        "标识符非值",
        "不能直接占位",
        "白名单映射"
      ],
      "bonus": "同类问题还包括动态表名与列名。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q5",
      "question": "如何在代码审计中快速定位高风险 SQL 构造？",
      "level": 3,
      "answer": "搜索字符串拼接、格式化字符串、原始查询 API 与模板占位差异，再沿输入来源确认是否可达外部数据。",
      "keyPoints": [
        "危险 API 清单",
        "数据流可达性",
        "动态标识符"
      ],
      "bonus": "同时检查存储后再次拼进语句的二次路径。",
      "sourceIds": [
        "tib3rius-interview",
        "cwe-89",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "cwe-89",
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q6",
      "question": "生产环境除了改代码，还应补哪些控制？",
      "level": 3,
      "answer": "数据库最小权限、禁用高危过程、收敛错误回显、WAF/检测规则与异常查询审计，形成不依赖单一点的控制链。",
      "keyPoints": [
        "权限",
        "回显",
        "检测"
      ],
      "bonus": "控制链要能在代码回归后继续提供告警。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q7",
      "question": "评审 `const column = SORTS[sortKey]; sql += ' ORDER BY ' + column` 时，你会检查什么？",
      "level": 4,
      "answer": "确认 SORTS 是服务端固定映射，并使用 Object.hasOwn 拒绝原型链属性和未知键；排序方向也需独立枚举，所有筛选值继续参数化。",
      "keyPoints": [
        "固定映射",
        "自有属性检查",
        "筛选值参数化"
      ],
      "bonus": "冻结映射对象并为 `__proto__`、未知键与异常排序方向增加单元测试。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q8",
      "question": "若业务必须动态拼排序与筛选，你会怎样设计安全接口？",
      "level": 4,
      "answer": "把允许的列名、操作符和排序方向定义为服务端枚举映射，值继续参数化，拒绝未知字段；记录被拒绝的键并测试恶意标识符、原型属性与空值。",
      "keyPoints": [
        "枚举映射",
        "值参数化",
        "未知拒绝"
      ],
      "bonus": "把映射表集中维护为安全边界文档。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention",
        "cwe-89"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention",
        "cwe-89"
      ]
    }
  ]
