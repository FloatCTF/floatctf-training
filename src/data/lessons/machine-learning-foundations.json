  "claims": [
    {
      "id": "claim-ai-ml-dl",
      "text": "机器学习通过数据调整模型，深度学习使用多层神经网络学习逐层表示。",
      "sourceIds": [
        "google-intro-ml",
        "d2l-index"
      ]
    },
    {
      "id": "claim-deep-model-depth",
      "text": "深层模型包含多个隐藏层，神经网络也包括层数更少的结构。",
      "sourceIds": [
        "google-ml-glossary"
      ]
    },
    {
      "id": "claim-learning-paradigms",
      "text": "监督、无监督、自监督和强化学习使用不同来源的训练信号。",
      "sourceIds": [
        "google-intro-ml",
        "google-ml-glossary"
      ]
    },
    {
      "id": "claim-feature-processing",
      "text": "数值归一化和类别编码把原始字段转换为模型可训练的向量，并需要在训练与推理阶段一致应用。",
      "sourceIds": [
        "google-normalization",
        "google-categorical"
      ]
    },
    {
      "id": "claim-linear-loss",
      "text": "回归损失衡量预测与真实数值之间的差异，均方误差通过平方移除误差方向。",
      "sourceIds": [
        "google-linear-loss"
      ]
    },
    {
      "id": "claim-logistic-probability",
      "text": "逻辑回归将线性 logit 输入 sigmoid，得到 0 与 1 之间的二分类概率。",
      "sourceIds": [
        "google-logistic-sigmoid"
      ]
    },
    {
      "id": "claim-logistic-loss",
      "text": "逻辑回归使用 log loss，并通常通过正则化控制参数复杂度。",
      "sourceIds": [
        "google-logistic-loss"
      ]
    },
    {
      "id": "claim-softmax-multilabel",
      "text": "Softmax 将互斥类别的 logit 归一化为和为 1 的概率；多标签分类允许多个标签同时成立。",
      "sourceIds": [
        "d2l-softmax"
      ]
    },
    {
      "id": "claim-regularization",
      "text": "L2 正则化在训练目标中惩罚较大的权重，正则化强度控制复杂度约束的影响。",
      "sourceIds": [
        "google-l2-regularization"
      ]
    },
    {
      "id": "claim-loss-gradient",
      "text": "梯度下降反复计算损失和梯度，并沿降低损失的方向更新模型参数。",
      "sourceIds": [
        "google-linear-gradient"
      ]
    },
    {
      "id": "claim-loss-curve-diagnostics",
      "text": "下降缓慢、振荡、爆炸和训练验证分叉的损失曲线对应不同训练问题。",
      "sourceIds": [
        "google-loss-curves"
      ]
    },
    {
      "id": "claim-optimizer-roles",
      "text": "优化器在梯度计算完成后更新参数，并可以维护动量或自适应缩放状态。",
      "sourceIds": [
        "pytorch-optimization",
        "pytorch-optim"
      ]
    },
    {
      "id": "claim-overfitting",
      "text": "过拟合模型在训练数据上表现良好，在新的未见数据上表现下降。",
      "sourceIds": [
        "google-overfitting"
      ]
    },
    {
      "id": "claim-regularization-techniques",
      "text": "Dropout、数据增强、权重约束和早停从不同环节控制过拟合风险。",
      "sourceIds": [
        "google-overfitting",
        "d2l-dropout",
        "d2l-image-augmentation"
      ]
    },
