    "assessments": [
      "none"
    ],
    "motionLevel": "simulation",
    "visualStory": "两条亲手制造的曲线贯穿全课：损失面上的下山轨迹（二维权重等高线 + 梯度下降模拟器，可拖学习率制造振荡与发散）与训练/考试误差的分叉（拟合实验台新增过拟合模式，拖多项式阶数看分叉）。嵌套边界图定位 AI/ML/DL，softmax 概率条对比集中度，数据流水线图（含泄漏红线）锚定第二节",
    "learningObjectives": [
      "解释 AI、机器学习与深度学习的层级关系，并比较规则系统与数据驱动系统",
      "用数据分布、特征表示、模型、训练目标和评估方案定义一个机器学习问题",
      "说明数值归一化、类别编码、缺失值处理和时间窗口怎样影响模型输入",
      "计算线性回归的平方损失、逻辑回归的 sigmoid 概率和二元交叉熵",
      "解释梯度、mini-batch、学习率、SGD、Momentum 与 Adam 的职责和边界",
      "使用训练曲线、数据切分、交叉验证、泄漏检查和多指标评估判断泛化"
    ],
    "prerequisites": [
      "高中数学：函数、平均数、指数与对数",
      "会阅读简单公式和数据表；不需要微积分基础，梯度与推导在课内现场建立"
    ],
    "safetyScope": "not-applicable",
    "verifiedAt": "2026-08-22"
  },
  "researchStatus": {
    "status": "complete",
    "verifiedAt": "2026-08-22",
    "queries": [
      "Google Machine Learning Crash Course linear logistic regression loss gradient data normalization generalization",
      "Stanford CS229 empirical risk minimization bias variance error analysis",
      "scikit-learn cross validation metrics probability calibration data leakage"
    ],
    "notes": "课程结构参考 Google MLCC、Stanford CS229 与 scikit-learn。2026-08-22 由原 90 分钟单课拆分：任务定义、数据、损失、优化与泛化留在本课，神经元、反向传播、架构与部署移入 neural-network-foundations；正文事实与来源沿用原核验。主动画吸收 3Blue1Brown 和 TensorFlow Playground 的可视化思路，用仓库内确定性公式生成状态；所有数值结果同时以静态记录呈现。"
  },
