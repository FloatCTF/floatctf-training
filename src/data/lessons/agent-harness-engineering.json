  "claims": [
    {
      "id": "claim-prompt-evaluation",
      "text": "优化模型 Prompt 之前应先定义成功标准和经验测试；模型选择、延迟与成本等问题需要相应的工程手段。",
      "sourceIds": [
        "anthropic-prompt-overview"
      ]
    },
    {
      "id": "claim-mcp-architecture",
      "text": "MCP 采用 Host、Client、Server 架构，并通过 JSON-RPC 数据层交换 Resources、Prompts、Tools 等能力。",
      "sourceIds": [
        "mcp-architecture"
      ]
    },
    {
      "id": "claim-mcp-safety",
      "text": "MCP Tools 可能触发任意数据访问或代码执行，Host 需要保留用户控制，并把不可信服务器提供的工具注解视为不可信信息。",
      "sourceIds": [
        "mcp-tools-spec"
      ]
    },
    {
      "id": "claim-skill-structure",
      "text": "Agent Skill 以带元数据的 SKILL.md 为入口，并可通过 references、assets 和 scripts 支持按需加载。",
      "sourceIds": [
        "agent-skills-spec"
      ]
    },
    {
      "id": "claim-mcp-skill-boundary",
      "text": "MCP Server 负责实时信息、认证授权和受控操作；Skill 负责工具顺序、决策点、缺失结果处理和输出要求。",
      "sourceIds": [
        "openai-skills"
      ]
    },
    {
      "id": "claim-context-scope",
      "text": "Prompt Engineering 主要处理指令的编写与组织，Context Engineering 管理模型推理时进入窗口的完整 token 集。",
      "sourceIds": [
        "anthropic-context-engineering"
      ]
    },
    {
      "id": "claim-long-context-position",
      "text": "在 Lost in the Middle 的多文档问答和键值检索实验中，相关信息位于长上下文中间时，模型表现常低于信息位于开头或末尾。",
      "sourceIds": [
        "lost-in-the-middle"
      ]
    },
    {
      "id": "claim-context-strategies",
      "text": "Write、Select、Compress 和 Isolate 可以作为组织 Agent Context Engineering 方法的实用分类。",
      "sourceIds": [
        "langchain-context-engineering"
      ]
    },
    {
      "id": "claim-harness-practice",
      "text": "OpenAI 的 Harness Engineering 实践把环境、结构化仓库知识、机械约束、验证和反馈循环作为提高 Agent 可靠性的主要工程对象。",
      "sourceIds": [
        "openai-harness-engineering"
      ]
    },
    {
      "id": "claim-harness-boundaries",
      "text": "Agent framework、runtime 和 harness 在当前行业用法中没有统一清晰的定义，职责边界存在重叠。",
      "sourceIds": [
        "langchain-harness-boundaries"
      ]
    },
    {
      "id": "claim-agent-evaluation",
      "text": "Agent 评测需要区分执行轨迹与环境最终状态，并通过多次 trial 观察随机系统的成功率与波动。",
      "sourceIds": [
        "anthropic-agent-evals"
      ]
    },
    {
      "id": "claim-agent-loop",
      "text": "ReAct 交错组织推理轨迹、行动和环境观察，使外部观察能够修正模型后续计划并帮助处理例外。",
      "sourceIds": [
        "react-paper"
      ]
    },
    {
      "id": "claim-workflow-agent-control",
      "text": "Workflow 使用预定义代码路径，Agent 由模型动态选择过程和工具；应从能够满足任务的最简单方案开始。",
      "sourceIds": [
        "anthropic-effective-agents"
      ]
    },
    {
      "id": "claim-loop-engineering-framework",
      "text": "LangChain 在 2026 年将 Loop Engineering 归纳为 Agent、Verification、Event-driven 与 Hill-climbing 四类反馈循环。",
      "sourceIds": [
        "langchain-loop-engineering"
      ]
    },
    {
      "id": "claim-graph-structure",
      "text": "LangGraph 使用 State、Nodes 和 Edges 描述可包含固定路由、条件分支与循环的状态化工作流。",
      "sourceIds": [
        "langgraph-graph-api"
      ]
    },
    {
      "id": "claim-adk-graphs",
      "text": "Google ADK 的 graph-based workflows 可以把 Agent、工具、函数和人工步骤作为节点，并用显式边进行路由。",
      "sourceIds": [
        "google-adk-graphs"
      ]
    },
    {
      "id": "claim-autogen-graphflow",
      "text": "AutoGen GraphFlow 使用有向图控制 Agent 执行，支持顺序、并行、条件分支和带退出条件的循环，当前仍标记为实验特性。",
      "sourceIds": [
        "autogen-graphflow"
      ]
    },
    {
      "id": "claim-multi-agent-orchestration",
      "text": "Anthropic 的 Research 系统由 Lead Agent 动态创建并行 Subagents，在独立上下文中搜索后汇总，形成运行时编排结构。",
      "sourceIds": [
        "anthropic-multi-agent"
      ]
    },
    {
      "id": "claim-graph-engineering-emergence",
      "text": "Graph Engineering 作为 AI Agent 行业说法在 2026 年 7 月中旬因 loops 与 graphs 的公开讨论集中传播。",
      "sourceIds": [
        "graph-origin-archive"
      ]
    }
  ],
