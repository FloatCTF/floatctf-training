    "motionLevel": "explanatory",
    "visualStory": "发布简报任务贯穿七层；上下文窗口演化主交互把检索、工具结果、压缩和 Lost in the Middle 位置衰减连成一条动态主线；轨迹回放作为辅助交互呈现 verify 失败与 replan 的证据流动，MCP 架构、Skill 加载与执行图用静态图示收束结构关系",
    "learningObjectives": [
      "区分 Prompt、MCP、Skills、Context、Harness、Loop 与 Graph 分别设计什么",
      "把模糊请求改写成包含依据、边界、输出契约和成功标准的任务规格",
      "解释 MCP 的 Host、Client、Server 与 Resources、Prompts、Tools，并说明协议和授权的边界",
      "比较 Skill、MCP、上下文与 Harness 在能力、流程、信息和执行控制上的职责",
      "用状态、验证、预算、停止和恢复条件描述一个可收敛的 Agent Loop",
      "用节点、边、共享状态、并行、汇合和人工检查点解释 Agent 执行图，并判断何时不需要图"
    ],
    "prerequisites": [
      "已完成 ai-literacy《大模型原理：从 Token 到对齐》",
      "了解 API、JSON、Git 与自动化测试的基本概念"
    ],
    "safetyScope": "not-applicable",
    "verifiedAt": "2026-08-28"
  },
  "exercises": [
    {
      "id": "check-1",
      "kind": "mechanism",
      "title": "判断完成条件",
      "question": "Agent 的回答写着“任务完成”，但外部测试失败。控制器应依据什么决定停止和成功？",
      "answer": "成功由预先约定的外部检查决定；失败进入有预算的修复或人工检查路径。达到预算上限时停止并报告失败。模型自述可以保留在轨迹中，成功状态由检查结果确定。",
      "sourceIds": [
        "anthropic-agent-evals"
      ]
    },
    {
      "id": "check-2",
      "kind": "calculation",
      "title": "读取失败轨迹",
      "question": "教学轨迹为“读取需求 → 修改文件 → 测试失败 → 宣布成功”。指出首个需要分支的位置，并补一条退出条件。",
      "answer": "在“测试失败”节点分支到诊断和修复；只有测试通过才进入成功。退出条件可设为最多 3 次修复，耗尽后报告失败和证据。这里的 3 次是题设预算。",
      "sourceIds": [
        "anthropic-effective-agents"
      ]
    },
    {
      "id": "check-3",
      "kind": "practice",
      "title": "画出有界反馈",
      "question": "在纸上画一个包含工具调用、外部校验、重试和人工检查的执行图，标出每条条件边。",
      "answer": "可用“工具调用 → 校验；通过 → 完成；失败且预算充足 → 修复 → 再校验；预算耗尽或权限不足 → 人工检查”。合格图应有可到达的停止节点，重试次数或成本上限明确。",
      "sourceIds": [
        "anthropic-effective-agents"
      ]
    }
  ],
