  "interviewQuestions": [
    {
      "id": "interview-q1",
      "question": "什么是 SQL 注入？它为什么危险？",
      "level": 1,
      "answer": "SQL 注入是把不可信输入解释成 SQL 语法或命令的一部分，从而改变查询语义；它直接作用于数据库中的数据与权限边界。",
      "keyPoints": [
        "输入被当 SQL 解释",
        "改变查询语义",
        "影响数据与权限"
      ],
      "bonus": "CWE-89 把它归类为特殊元素中和不足。",
      "sourceIds": [
        "tib3rius-interview",
        "cwe-89",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "cwe-89",
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q2",
      "question": "你会怎么修复 SQL 注入？",
      "level": 1,
      "answer": "优先使用参数化查询或安全 ORM API，把用户输入绑定为数据并保持语句结构固定，同时配合最小权限账户。",
      "keyPoints": [
        "参数化/预编译",
        "安全 API",
        "最小权限"
      ],
      "bonus": "OWASP 将参数化查询列为首选防御。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q3",
      "question": "为什么只做输入过滤或转义单引号往往不够？",
      "level": 2,
      "answer": "编码、数值上下文、二次拼接、不同数据库语法和宽字节等问题会绕过简单过滤，结构绑定比字符黑名单更稳定。",
      "keyPoints": [
        "上下文差异",
        "二次使用",
        "黑名单脆弱"
      ],
      "bonus": "防御应优先固定语句结构，再谈辅助校验。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q4",
      "question": "联合查询注入和盲注在验证信号上有什么差别？",
      "level": 2,
      "answer": "联合查询依赖响应中的数据回显位；盲注则通过布尔结果差异或时间差推断数据，不需要直接回显。",
      "keyPoints": [
        "回显 vs 推断",
        "布尔/时间信号",
        "利用条件不同"
      ],
      "bonus": "选择手法取决于应用是否把查询结果展示给用户。",
      "sourceIds": [
        "tib3rius-interview",
        "cwe-89"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "cwe-89"
      ]
    },
    {
      "id": "interview-q5",
      "question": "参数化查询为什么能挡住经典注入？",
      "level": 3,
      "answer": "参数化 API 分别传递语句模板和参数，数据库按值处理参数，因此输入无法改写关键字、操作符或子句结构；具体执行计划可随数据库与数据变化。",
      "keyPoints": [
        "模板与参数分离",
        "参数是值",
        "结构不可改写"
      ],
      "bonus": "ORDER BY 等标识符位置通常不能参数化，需要白名单。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q6",
      "question": "如何设计登录接口的纵深防御？",
      "level": 3,
      "answer": "参数化查询是主防线，再叠加账户锁定与审计、错误信息收敛、数据库账户最小权限和异常查询检测。",
      "keyPoints": [
        "参数化主防线",
        "权限收敛",
        "可观测性"
      ],
      "bonus": "WAF 只能作为附加层，不能替代代码层修复。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q7",
      "question": "代码评审中看到 `WHERE name = '${name}' ORDER BY ${sort}`，你会按什么顺序审查？",
      "level": 4,
      "answer": "先追踪所有输入来源和调用点，确认是否存在参数化替代，检查动态表名与排序字段是否白名单，并评估权限与错误回显。",
      "keyPoints": [
        "数据流追踪",
        "动态标识符",
        "权限与回显"
      ],
      "bonus": "重点标出二次拼接：先安全存储、后不安全拼进新语句的路径。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-sqli-prevention",
        "cwe-89"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention",
        "cwe-89"
      ]
    },
    {
      "id": "interview-q8",
      "question": "发现疑似 SQL 注入后，你如何在授权范围内验证并推动修复？",
      "level": 4,
      "answer": "确认书面授权、目标与停止条件后，在测试环境使用只读账户和最小探测验证输入是否影响查询语义；保存请求、响应与日志证据，随后推动参数化修复并为原注入点和相邻查询增加回归测试。",
      "keyPoints": [
        "授权与最小探测",
        "只读环境与停止条件",
        "证据记录",
        "修复与回归"
      ],
      "bonus": "MOVEit 案例体现数据窃取风险；FortiClientEMS 案例体现代码或命令执行风险。",
      "sourceIds": [
        "tib3rius-interview",
        "cve-2023-34362",
        "cve-2023-48788",
        "progress-moveit-advisory",
        "nvd-cve-2023-48788",
        "fortinet-cve-2023-48788",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
