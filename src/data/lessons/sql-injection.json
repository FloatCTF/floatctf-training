  "interviewQuestions": [
    {
      "id": "interview-q1",
      "question": "什么是 SQL 注入？它为什么危险？",
      "level": 1,
      "answer": "SQL 注入是把不可信输入解释成 SQL 语法或命令的一部分，从而改变查询语义；它直接作用于数据库中的数据与权限边界。",
      "keyPoints": [
        "输入被当 SQL 解释",
        "改变查询语义",
        "影响数据与权限"
      ],
      "bonus": "CWE-89 把它归类为特殊元素中和不足。",
      "sourceIds": [
        "appsec-interview-gist",
        "cwe-89",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cwe-89",
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q2",
      "question": "你会怎么修复 SQL 注入？",
      "level": 1,
      "answer": "优先使用参数化查询或安全 ORM API，把用户输入绑定为数据而不是拼进语句结构，并配合最小权限账户。",
      "keyPoints": [
        "参数化/预编译",
        "安全 API",
        "最小权限"
      ],
      "bonus": "OWASP 将参数化查询列为首选防御。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q3",
      "question": "为什么只做输入过滤或转义单引号往往不够？",
      "level": 2,
      "answer": "编码、数值上下文、二次拼接、不同数据库语法和宽字节等问题会绕过简单过滤，结构绑定比字符黑名单更稳定。",
      "keyPoints": [
        "上下文差异",
        "二次使用",
        "黑名单脆弱"
      ],
      "bonus": "防御应优先固定语句结构，再谈辅助校验。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q4",
      "question": "联合查询注入和盲注在验证信号上有什么差别？",
      "level": 2,
      "answer": "联合查询依赖响应中的数据回显位；盲注则通过布尔结果差异或时间差推断数据，不需要直接回显。",
      "keyPoints": [
        "回显 vs 推断",
        "布尔/时间信号",
        "利用条件不同"
      ],
      "bonus": "选择手法取决于应用是否把查询结果展示给用户。",
      "sourceIds": [
        "appsec-interview-gist",
        "cwe-89"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cwe-89"
      ]
    },
    {
      "id": "interview-q5",
      "question": "参数化查询为什么能挡住经典注入？",
      "level": 3,
      "answer": "数据库先编译固定语句模板再绑定参数，参数只填充值节点，不能改写关键字、操作符或子句结构。",
      "keyPoints": [
        "模板先编译",
        "参数是值",
        "结构不可改写"
      ],
      "bonus": "ORDER BY 等标识符位置通常不能参数化，需要白名单。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q6",
      "question": "如何设计登录接口的纵深防御？",
      "level": 3,
      "answer": "参数化查询是主防线，再叠加账户锁定与审计、错误信息收敛、数据库账户最小权限和异常查询检测。",
      "keyPoints": [
        "参数化主防线",
        "权限收敛",
        "可观测性"
      ],
      "bonus": "WAF 只能作为附加层，不能替代代码层修复。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention"
      ]
    },
    {
      "id": "interview-q7",
      "question": "代码评审中看到字符串拼接 SQL，你会按什么顺序审查？",
      "level": 4,
      "answer": "先追踪所有输入来源和调用点，确认是否存在参数化替代，检查动态表名与排序字段是否白名单，并评估权限与错误回显。",
      "keyPoints": [
        "数据流追踪",
        "动态标识符",
        "权限与回显"
      ],
      "bonus": "重点标出二次拼接：先安全存储、后不安全拼进新语句的路径。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-sqli-prevention",
        "cwe-89"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-sqli-prevention",
        "cwe-89"
      ]
    },
    {
      "id": "interview-q8",
      "question": "发现疑似 SQL 注入后，你如何在授权范围内验证并推动修复？",
      "level": 4,
      "answer": "在书面授权环境用最小探测确认输入是否改变查询语义，记录证据后推动参数化修复，并用回归用例覆盖原注入点与相邻查询。",
      "keyPoints": [
        "授权与最小探测",
        "证据记录",
        "修复与回归"
      ],
      "bonus": "CVE-2023-34362 与 CVE-2023-48788 说明注入可升级为大规模数据窃取或远程执行链路。",
      "sourceIds": [
        "appsec-interview-gist",
        "cve-2023-34362",
        "cve-2023-48788",
        "owasp-sqli-prevention"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cve-2023-34362",
        "cve-2023-48788",
        "owasp-sqli-prevention"
      ]
    }
  ]
