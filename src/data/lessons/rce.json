  "interviewQuestions": [
    {
      "id": "interview-q1",
      "question": "什么是命令注入？",
      "level": 1,
      "answer": "命令注入是把不可信输入拼进操作系统命令，使 shell 或命令解释器执行额外指令。",
      "keyPoints": [
        "不可信输入",
        "进入 OS 命令",
        "额外指令"
      ],
      "bonus": "对应 CWE-78。",
      "sourceIds": [
        "tib3rius-interview",
        "cwe-78",
        "owasp-command-injection"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "cwe-78",
        "owasp-command-injection"
      ]
    },
    {
      "id": "interview-q2",
      "question": "命令注入和 SQL 注入有什么相同点？",
      "level": 1,
      "answer": "两者都是把数据解释成另一种语言的语法；差别在目标解释器分别是 shell 与 SQL 引擎。",
      "keyPoints": [
        "数据变语法",
        "解释器不同",
        "结构绑定思想类似"
      ],
      "bonus": "修复都强调避免字符串拼进解释器语言。",
      "sourceIds": [
        "tib3rius-interview",
        "cwe-78",
        "owasp-command-defense"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "cwe-78",
        "owasp-command-defense"
      ]
    },
    {
      "id": "interview-q3",
      "question": "为什么 `ping` 功能容易出命令注入？",
      "level": 2,
      "answer": "常见实现把主机名拼进 shell 命令字符串，输入中的分隔符可以追加新命令。",
      "keyPoints": [
        "shell 拼接",
        "分隔符",
        "额外命令"
      ],
      "bonus": "应用应使用无 shell 的进程 API 并校验主机格式。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-command-injection"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-command-injection"
      ]
    },
    {
      "id": "interview-q4",
      "question": "参数数组 API 如何降低风险？",
      "level": 2,
      "answer": "shell=false 时参数作为独立 argv 传递，分号和管道不会被 shell 当成命令分隔符；目标程序仍会解释自己的参数，因此还需阻止选项注入并校验业务语义。",
      "keyPoints": [
        "不经 shell",
        "argv 独立",
        "shell 元字符不再分隔命令",
        "目标程序仍解析选项"
      ],
      "bonus": "仍需校验参数语义，防止合法程序被喂入危险参数。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-command-defense",
        "node-child-process"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-command-defense",
        "node-child-process"
      ]
    },
    {
      "id": "interview-q5",
      "question": "语言级代码执行与 OS 命令注入的执行边界有何差异？",
      "level": 3,
      "answer": "语言级代码执行让输入进入 eval、模板或表达式等语言解释器；OS 命令注入让输入进入 shell 或外部程序参数。两条路径可能互相衔接，审计时应分别标出解释器与进程边界。",
      "keyPoints": [
        "语言解释器",
        "shell 与进程参数",
        "边界衔接"
      ],
      "bonus": "Log4Shell 是间接求值导致 RCE 的典型。",
      "sourceIds": [
        "tib3rius-interview",
        "cve-2021-44228",
        "log4j-security"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "cve-2021-44228",
        "log4j-security"
      ]
    },
    {
      "id": "interview-q6",
      "question": "如何设计外部命令调用的安全封装？",
      "level": 3,
      "answer": "固定可执行文件路径，使用 argv 传参并禁用 shell，对每个参数做允许列表，设置超时与 maxBuffer，检查 error、status 和 signal，并以最小权限用户运行。",
      "keyPoints": [
        "固定二进制",
        "argv",
        "白名单",
        "资源上限与结果检查",
        "最小权限"
      ],
      "bonus": "默认拒绝未知参数比黑名单更稳。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-command-defense",
        "node-child-process"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-command-defense",
        "node-child-process"
      ]
    },
    {
      "id": "interview-q7",
      "question": "代码评审看到 `execSync('ping -c 1 ' + host)`，你会怎样修复并验证？",
      "level": 4,
      "answer": "先用语言库替代 ping；确需调用时改成固定路径和 argv，设置 shell=false、超时、输出上限及最小权限，并对 host 做 IP 或受控域名语义校验。测试覆盖 shell 元字符、选项前缀、超长输出和超时场景。",
      "keyPoints": [
        "移除 shell 拼接",
        "参数语义校验",
        "资源与异常测试"
      ],
      "bonus": "POSIX 工具支持时可在用户参数前加入 `--` 终止选项解析，同时保留允许列表校验。",
      "sourceIds": [
        "tib3rius-interview",
        "owasp-command-defense",
        "node-child-process",
        "cwe-78"
      ],
      "questionSourceIds": [
        "tib3rius-interview"
      ],
      "answerSourceIds": [
        "owasp-command-defense",
        "node-child-process",
        "cwe-78"
      ]
    },
    {
      "id": "interview-q8",
      "question": "Log4Shell 与 Spring4Shell 的成立条件和修复路径分别是什么？",
      "level": 4,
      "answer": "Log4Shell 需核对 log4j-core 版本、攻击者数据是否进入消息查找以及 JNDI 相关运行条件，修复以升级受支持版本为主。Spring4Shell 的公开利用链要求受影响的 Spring Framework、JDK 9+、Web MVC/WebFlux、传统 WAR 和相应 Servlet 容器条件，修复到 5.3.18 或 5.2.20 及以上。",
      "keyPoints": [
        "组件与版本清单",
        "触发条件核对",
        "升级到修复版本"
      ],
      "bonus": "Spring Boot 默认可执行 JAR 部署不满足公开 Spring4Shell 利用链的 WAR 条件，仍应根据依赖版本和实际部署逐项核验。",
      "sourceIds": [
