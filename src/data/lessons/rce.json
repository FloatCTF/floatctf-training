  "interviewQuestions": [
    {
      "id": "interview-q1",
      "question": "什么是命令注入？",
      "level": 1,
      "answer": "命令注入是把不可信输入拼进操作系统命令，使 shell 或命令解释器执行额外指令。",
      "keyPoints": [
        "不可信输入",
        "进入 OS 命令",
        "额外指令"
      ],
      "bonus": "对应 CWE-78。",
      "sourceIds": [
        "appsec-interview-gist",
        "cwe-78",
        "owasp-command-injection"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cwe-78",
        "owasp-command-injection"
      ]
    },
    {
      "id": "interview-q2",
      "question": "命令注入和 SQL 注入有什么相同点？",
      "level": 1,
      "answer": "两者都是把数据解释成另一种语言的语法；差别在目标解释器分别是 shell 与 SQL 引擎。",
      "keyPoints": [
        "数据变语法",
        "解释器不同",
        "结构绑定思想类似"
      ],
      "bonus": "修复都强调避免字符串拼进解释器语言。",
      "sourceIds": [
        "appsec-interview-gist",
        "cwe-78",
        "owasp-command-defense"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cwe-78",
        "owasp-command-defense"
      ]
    },
    {
      "id": "interview-q3",
      "question": "为什么 `ping` 功能容易出命令注入？",
      "level": 2,
      "answer": "常见实现把主机名拼进 shell 命令字符串，输入中的分隔符可以追加新命令。",
      "keyPoints": [
        "shell 拼接",
        "分隔符",
        "额外命令"
      ],
      "bonus": "应用应使用无 shell 的进程 API 并校验主机格式。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-command-injection"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-command-injection"
      ]
    },
    {
      "id": "interview-q4",
      "question": "参数数组 API 如何降低风险？",
      "level": 2,
      "answer": "参数作为独立 argv 传递，不经 shell 解析元字符，因此分号和管道不再具备命令分隔作用。",
      "keyPoints": [
        "不经 shell",
        "argv 独立",
        "元字符失效"
      ],
      "bonus": "仍需校验参数语义，防止合法程序被喂入危险参数。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-command-defense"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-command-defense"
      ]
    },
    {
      "id": "interview-q5",
      "question": "除了命令注入，还有哪些常见 RCE 入口？",
      "level": 3,
      "answer": "语言 eval、不安全反序列化、模板注入、表达式注入以及存在漏洞的日志/框架特性。",
      "keyPoints": [
        "eval",
        "反序列化",
        "模板/表达式",
        "框架特性"
      ],
      "bonus": "Log4Shell 是间接求值导致 RCE 的典型。",
      "sourceIds": [
        "appsec-interview-gist",
        "cve-2021-44228",
        "log4j-security"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cve-2021-44228",
        "log4j-security"
      ]
    },
    {
      "id": "interview-q6",
      "question": "如何设计外部命令调用的安全封装？",
      "level": 3,
      "answer": "固定可执行文件路径，使用 argv 传参，对每个参数做允许列表，设置超时、最小权限用户与无 shell 执行。",
      "keyPoints": [
        "固定二进制",
        "argv",
        "白名单",
        "最小权限"
      ],
      "bonus": "默认拒绝未知参数比黑名单更稳。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-command-defense"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-command-defense"
      ]
    },
    {
      "id": "interview-q7",
      "question": "发现可能的 RCE 时，授权验证应遵守什么边界？",
      "level": 4,
      "answer": "只在授权环境用最小、可回滚的验证证明执行点存在，避免持久化、横向移动或破坏性命令，并立刻推动临时缓解。",
      "keyPoints": [
        "授权范围",
        "最小验证",
        "临时缓解"
      ],
      "bonus": "验证记录应包含输入路径、进程身份与时间。",
      "sourceIds": [
        "appsec-interview-gist",
        "owasp-command-defense",
        "cwe-78"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "owasp-command-defense",
        "cwe-78"
      ]
    },
    {
      "id": "interview-q8",
      "question": "Log4Shell 对防御设计的启示是什么？",
      "level": 4,
      "answer": "间接字符串求值与外部查找会把“日志输入”变成执行面，因此依赖组件要可盘点、可升级，并关闭不必要的查找与反序列化特性。",
      "keyPoints": [
        "间接求值",
        "依赖治理",
        "关闭危险特性"
      ],
      "bonus": "CVE-2021-44228 与 CVE-2022-22965 都说明框架默认能力可能变成攻击面。",
      "sourceIds": [
        "appsec-interview-gist",
        "cve-2021-44228",
        "log4j-security",
        "cve-2022-22965"
      ],
      "questionSourceIds": [
        "appsec-interview-gist"
      ],
      "answerSourceIds": [
        "cve-2021-44228",
        "log4j-security",
        "cve-2022-22965"
      ]
    }
  ]
