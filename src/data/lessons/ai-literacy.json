  "claims": [
    {
      "id": "claim-tokenizer-role",
      "text": "Tokenizer 在文本和模型使用的整数 token ID 之间转换，模型处理的是数值序列。",
      "sourceIds": [
        "hf-llm-course"
      ]
    },
    {
      "id": "claim-autoregressive-model",
      "text": "自回归语言模型依据已有 token 序列计算后续 token 的条件概率分布。",
      "sourceIds": [
        "brown-2020"
      ]
    },
    {
      "id": "claim-in-context-learning",
      "text": "模型可以通过输入中的任务说明和示例完成部分任务，推理时不发生参数更新。",
      "sourceIds": [
        "brown-2020"
      ]
    },
    {
      "id": "claim-transformer-attention",
      "text": "Transformer 用缩放点积注意力和多头注意力组合序列中不同位置的信息。",
      "sourceIds": [
        "vaswani-2017"
      ]
    },
    {
      "id": "claim-attention-complexity",
      "text": "稠密全自注意力包含 n×n 个位置关系，核心计算量随序列长度平方增长；朴素实现还会显式保存同规模的中间矩阵。",
      "sourceIds": [
        "vaswani-2017"
      ]
    },
    {
      "id": "claim-long-context-position",
      "text": "长上下文中的信息位置会影响部分语言模型的检索和问答表现，中部信息可能更难被稳定利用。",
      "sourceIds": [
        "liu-2023"
      ]
    },
    {
      "id": "claim-memory-efficient-attention",
      "text": "FlashAttention 通过分块计算减少 GPU 高带宽内存与片上存储之间的读写，同时保持精确注意力结果。",
      "sourceIds": [
        "dao-2022-flashattention"
      ]
    },
    {
      "id": "claim-course-structure",
